---
// Diálogos globais: paleta de busca e painel de progresso.
// Ficam no fim do <body> e são reaproveitados por todas as páginas.
import Icone from './Icone.astro';
import { u } from '../lib/url';
---

<!-- ------------------------------------------------------------ busca -->
<dialog id="busca" class="painel painel--busca" aria-label="Buscar aula">
  <div class="busca__campo">
    <Icone nome="magnifying-glass" class="busca__lupa" />
    <!-- Padrão "combobox com lista": o foco fica no campo e as setas movem o
         destaque entre os resultados (aria-activedescendant, ver app.ts). -->
    <input
      type="search"
      data-busca-campo
      placeholder="Buscar por aula, matéria ou área…"
      autocomplete="off"
      spellcheck="false"
      aria-label="Buscar aula"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="true"
      aria-controls="busca-lista"
      aria-describedby="busca-contador"
    />
    <!-- Fechar na própria linha do campo: alinha com a lupa e o texto e nunca cobre a borda. -->
    <form method="dialog" class="painel__fechar-form">
      <button class="painel__fechar" data-fecha aria-label="Fechar busca"><Icone nome="xmark" /></button>
    </form>
  </div>

  <!-- Região viva: quem usa leitor de tela ouve "12 resultados" ao digitar. -->
  <p class="busca__contador" id="busca-contador" data-busca-contador role="status">Sugestões do que ainda falta ver</p>

  <div class="busca__rolagem" data-rolagem>
    <ul class="busca__lista" id="busca-lista" data-busca-lista role="listbox" aria-label="Resultados da busca" data-rolagem-area></ul>
  </div>

  <p class="busca__vazio" data-busca-vazio hidden role="status">
    <Icone nome="circle-info" /> Nenhuma aula encontrada com esse termo.
  </p>

  <footer class="busca__rodape">
    <span><kbd>↑</kbd><kbd>↓</kbd> navegar</span>
    <span><kbd>Enter</kbd> abrir</span>
    <span><kbd>Esc</kbd> fechar</span>
  </footer>
</dialog>

<!-- -------------------------------------------------------- progresso -->
<dialog id="progresso" class="painel" aria-labelledby="progresso-titulo" data-rolagem>
  <div class="painel__area" data-rolagem-area>
    <!-- Cabeçalho fixo: o ícone, o título e o botão de fechar acompanham a rolagem. -->
    <header class="painel__cabeca">
      <h2 class="painel__titulo" id="progresso-titulo"><Icone nome="chart-simple" duo cor="var(--color-escolar)" /> Meu progresso</h2>
      <form method="dialog" class="painel__fechar-form">
        <button class="painel__fechar" data-fecha aria-label="Fechar progresso"><Icone nome="xmark" /></button>
      </form>
    </header>
    <p class="painel__sub">
      Fica salvo só neste navegador, no seu aparelho. Nada é enviado para servidor nenhum.
    </p>

    <div data-painel-progresso>
      <p class="painel__carregando">Carregando…</p>
    </div>

    <footer class="painel__rodape">
      <button type="button" class="painel__botao" data-acao="sortear">
        <Icone nome="dice" /> Sortear uma aula
      </button>
      <button type="button" class="painel__botao painel__botao--perigo" data-acao="zerar-progresso">
        <Icone nome="rotate-left" /> Zerar progresso
      </button>
    </footer>
  </div>
</dialog>

<!-- ------------------------------------------------------------ sumário -->
<dialog id="sumario" class="painel painel--sumario" aria-labelledby="sumario-titulo" data-rolagem>
  <div class="painel__area" data-rolagem-area>
    <header class="painel__cabeca">
      <h2 class="painel__titulo" id="sumario-titulo"><Icone nome="list-ol" duo cor="var(--color-escolar)" /> Sumário da aula</h2>
      <form method="dialog" class="painel__fechar-form">
        <button class="painel__fechar" data-fecha aria-label="Fechar sumário"><Icone nome="xmark" /></button>
      </form>
    </header>
    <p class="painel__sub">Escolha um tópico para ir direto até ele. Se estiver recolhido, abre sozinho.</p>
    <ol class="sumario__lista" data-sumario-lista></ol>
  </div>
</dialog>

<!-- ---------------------------------------------------- acessibilidade -->
<dialog id="acessibilidade" class="painel" aria-labelledby="a11y-titulo" data-rolagem>
  <div class="painel__area" data-rolagem-area>
    <header class="painel__cabeca">
      <h2 class="painel__titulo" id="a11y-titulo">
        <Icone nome="universal-access" duo cor="var(--color-escolar)" /> Acessibilidade
      </h2>
      <form method="dialog" class="painel__fechar-form">
        <button class="painel__fechar" data-fecha aria-label="Fechar acessibilidade"><Icone nome="xmark" /></button>
      </form>
    </header>
    <p class="painel__sub">
      Ajustes de leitura e navegação. Ficam salvos neste navegador e valem para
      todas as páginas do caderno.
    </p>

    <div class="a11y">
      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-texto">Tamanho do texto</span>
          <span class="a11y__desc">
            Aumenta ou diminui só o texto das aulas e das questões, de 14 a 28 pixels. O padrão é 16.
          </span>
        </div>
        <div class="a11y__controle-fonte" data-controle-fonte>
          <div class="a11y__trilho-fonte">
            <input type="range" class="a11y__slider-fonte" data-slider-fonte min="14" max="28" step="1" value="16" aria-labelledby="a11y-texto" />
            <i class="a11y__marca-padrao" aria-hidden="true"></i>
          </div>
          <span class="a11y__fonte-display" data-fonte-display>16px · padrão</span>
        </div>
      </div>

      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-espaco">Espaçamento de leitura</span>
          <span class="a11y__desc">
            Abre as entrelinhas e afasta as letras. Ajuda quem tem dislexia ou baixa visão.
          </span>
        </div>
        <button
          type="button"
          class="a11y__chave"
          data-a11y="espacamento"
          role="switch"
          aria-checked="false"
          aria-labelledby="a11y-espaco"
        ><span class="a11y__bolinha"></span></button>
      </div>

      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-contraste">Alto contraste</span>
          <span class="a11y__desc">Reforça bordas e escurece o texto para leitura em tela clara demais.</span>
        </div>
        <button
          type="button"
          class="a11y__chave"
          data-a11y="contraste"
          role="switch"
          aria-checked="false"
          aria-labelledby="a11y-contraste"
        ><span class="a11y__bolinha"></span></button>
      </div>

      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-movimento">Reduzir animações</span>
          <span class="a11y__desc">
            Desliga transições e entradas animadas. Já vem ligado se o sistema pedir menos movimento.
          </span>
        </div>
        <button
          type="button"
          class="a11y__chave"
          data-a11y="movimento"
          role="switch"
          aria-checked="false"
          aria-labelledby="a11y-movimento"
        ><span class="a11y__bolinha"></span></button>
      </div>

      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-links">Sublinhar todos os links</span>
          <span class="a11y__desc">Deixa de depender só da cor para indicar o que é clicável.</span>
        </div>
        <button
          type="button"
          class="a11y__chave"
          data-a11y="links"
          role="switch"
          aria-checked="false"
          aria-labelledby="a11y-links"
        ><span class="a11y__bolinha"></span></button>
      </div>

      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-atalhos">Atalhos de uma tecla</span>
          <span class="a11y__desc">
            A barra <kbd>/</kbd> abre a busca e as setas <kbd>&larr;</kbd> <kbd>&rarr;</kbd> trocam de
            aula. Desligue se ativa sem querer, por exemplo ao usar comando de voz ou rolar a tela
            ampliada. <kbd>Ctrl</kbd> + <kbd>K</kbd> continua funcionando.
          </span>
        </div>
        <button
          type="button"
          class="a11y__chave"
          data-a11y="atalhos"
          role="switch"
          aria-checked="true"
          aria-labelledby="a11y-atalhos"
        ><span class="a11y__bolinha"></span></button>
      </div>

      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-correcao">Correção imediata das questões</span>
          <span class="a11y__desc">
            Ao marcar uma alternativa, o caderno já diz se está certa. Desligue para marcar todas e
            corrigir no fim, pelo botão Corrigir respostas. Pelo teclado, confirme com o botão
            Confirmar resposta ou com <kbd>Enter</kbd>.
          </span>
        </div>
        <button
          type="button"
          class="a11y__chave"
          data-a11y="correcao"
          role="switch"
          aria-checked="true"
          aria-labelledby="a11y-correcao"
        ><span class="a11y__bolinha"></span></button>
      </div>

      <div class="a11y__linha">
        <div class="a11y__info">
          <span class="a11y__nome" id="a11y-brilho">Brilho do tema claro</span>
          <span class="a11y__desc">
            Escurece o tema claro para cansar menos a vista, sem trocar para o escuro. Não altera o
            tema escuro. Abaixo de 80% o contraste de alguns textos diminui.
          </span>
        </div>
        <div class="a11y__controle-fonte" data-controle-brilho>
          <div class="a11y__trilho-fonte">
            <input type="range" class="a11y__slider-fonte" data-slider-brilho min="75" max="100" step="5" value="100" aria-labelledby="a11y-brilho" />
          </div>
          <span class="a11y__fonte-display" data-brilho-display>100% · padrão</span>
        </div>
      </div>
    </div>

    <div class="a11y__restaurar">
      <button type="button" class="painel__botao" data-acao="restaurar-a11y" disabled>
        <Icone nome="rotate-left" /> Voltar ao padrão
      </button>
    </div>

    <h3 class="a11y__subtitulo"><Icone nome="keyboard" /> Atalhos de teclado</h3>
    <ul class="a11y__atalhos">
      <li><kbd>Tab</kbd> percorre os controles da página</li>
      <li><kbd>Ctrl</kbd> + <kbd>K</kbd> abre e fecha a busca; <kbd>/</kbd> também abre</li>
      <li><kbd>&larr;</kbd> <kbd>&rarr;</kbd> trocam de aula dentro da matéria</li>
      <li><kbd>Esc</kbd> fecha qualquer painel aberto</li>
      <li>No quiz, <kbd>&uarr;</kbd> <kbd>&darr;</kbd> escolhem a alternativa</li>
    </ul>

    <p class="a11y__rodape">
      <Icone nome="universal-access" />
      <span>
        <a href={u('/acessibilidade')}>Declaração de acessibilidade</a>: o que o site já oferece,
        limites conhecidos e como relatar uma barreira.
      </span>
    </p>
  </div>
</dialog>

<!-- ------------------------------------------------------- confirmação
     Lugar do confirm() nativo, que alguns navegadores (e o app) bloqueiam e que então
     devolve "não" sem mostrar nada. Usado por confirmarAcao() em app.ts. -->
<dialog id="confirmar" class="painel painel--confirmar" aria-labelledby="confirmar-titulo" aria-describedby="confirmar-texto">
  <h2 class="painel__titulo" id="confirmar-titulo" data-confirmar-titulo>Confirmar</h2>
  <p class="painel__sub confirmar__texto" id="confirmar-texto" data-confirmar-texto></p>
  <label class="confirmar__extra" data-confirmar-extra hidden>
    <input type="checkbox" data-confirmar-extra-caixa />
    <span data-confirmar-extra-texto></span>
  </label>
  <footer class="painel__rodape confirmar__acoes">
    <button type="button" class="painel__botao" data-fecha autofocus>Cancelar</button>
    <button type="button" class="painel__botao painel__botao--perigo" data-confirmar-ok>Confirmar</button>
  </footer>
</dialog>

<style>
  .painel--confirmar {
    width: min(26rem, calc(100vw - 1.5rem));
  }
  .confirmar__texto {
    max-width: none;
    margin-bottom: 1rem;
  }
  .confirmar__extra {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0 0 0.25rem;
    font-family: var(--font-body);
    font-size: calc(0.86rem * var(--escala-texto, 1));
    line-height: 1.5;
    cursor: pointer;
  }
  .confirmar__extra[hidden] {
    display: none;
  }
  .confirmar__extra input {
    margin-top: 0.2rem;
    accent-color: var(--color-escolar);
    flex-shrink: 0;
  }
  .confirmar__acoes {
    justify-content: flex-end;
  }
  .painel {
    /* Sem position própria: o `position: fixed; inset: 0; margin: auto` do
       navegador é o que centraliza o diálogo modal na tela. */
    margin: auto;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    padding: 1.5rem 1.25rem 1.1rem;
    width: min(38rem, calc(100vw - 1.5rem));
    max-height: min(80vh, 46rem);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
  }
  /* Painéis que rolam inteiros: o diálogo só enquadra e a área interna rola, para a
     barra de rolagem própria (barra-rolagem.ts) ficar parada sobre a borda. */
  .painel[data-rolagem] {
    padding: 0;
    /* A trilha da barra de rolagem começa abaixo do cabeçalho fixo. */
    --folga-topo: 4.2rem;
  }
  .painel[data-rolagem][open] {
    display: flex;
    flex-direction: column;
  }
  .painel__area {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* À direita sobra a faixa da barra de rolagem (barra de 24px + 4px de recuo + respiro),
       sem encostar nos controles. O respiro de cima fica no cabeçalho fixo, para ele colar
       na borda ao rolar. */
    --faixa-barra: 2.6rem;
    padding: 0 var(--faixa-barra) 1.1rem 1.25rem;
  }
  /* Cabeçalho fixo dos painéis que rolam: ícone, título e botão de fechar não saem da
     tela. Sticky dentro da área que rola; a margem negativa estende o fundo até as bordas. */
  .painel__cabeca {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 calc(-1 * var(--faixa-barra)) 1rem -1.25rem;
    padding: 1rem 1.5rem 0.7rem 1.25rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .painel__cabeca .painel__titulo {
    margin: 0;
  }
  .painel__cabeca .painel__fechar-form {
    position: static;
    flex-shrink: 0;
  }
  .painel[open] {
    animation: painel-entra 0.18s var(--ease) both;
    will-change: transform, opacity;
  }
  /* Sem backdrop-filter: desfocar a página inteira atrás do diálogo custava
     um repaint de tela cheia por quadro e era o que fazia a abertura da busca
     engasgar. Um véu opaco entrega o mesmo isolamento visual de graça. */
  .painel::backdrop {
    background: color-mix(in srgb, #0c0f14 72%, transparent);
    animation: fade 0.18s var(--ease) both;
  }
  @keyframes painel-entra {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .painel__fechar-form {
    position: absolute;
    top: 0.6rem;
    right: 0.7rem;
    margin: 0;
    z-index: 2;
  }
  .painel__fechar {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--color-ink-soft);
    cursor: pointer;
  }
  .painel__fechar:hover {
    background: var(--color-paper-dark);
    color: var(--color-ink);
  }

  .painel__titulo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: calc(1.15rem * var(--escala-texto, 1));
    font-weight: 700;
    margin: 0 0 0.3rem;
  }
  .painel__sub {
    font-family: var(--font-body);
    font-size: calc(0.85rem * var(--escala-texto, 1));
    color: var(--color-ink-soft);
    margin: 0 0 1.25rem;
    max-width: 30rem;
  }
  .painel__carregando {
    font-family: var(--font-body);
    font-size: calc(0.85rem * var(--escala-texto, 1));
    color: var(--color-ink-soft);
  }
  .painel__rodape {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }
  .painel__botao {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: calc(0.78rem * var(--escala-texto, 1));
    font-weight: 600;
    cursor: pointer;
  }
  .painel__botao:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
    background: var(--color-paper-dark);
  }
  .painel__botao--perigo:hover {
    color: var(--color-enem);
    border-color: var(--color-enem);
    background: var(--color-enem-soft);
  }

  /* --------------------------------------------------- acessibilidade */
  .a11y {
    display: flex;
    flex-direction: column;
  }
  .a11y__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .a11y__linha:first-child {
    padding-top: 0;
  }
  .a11y__info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .a11y__nome {
    font-family: var(--font-display);
    font-size: calc(0.88rem * var(--escala-texto, 1));
    font-weight: 700;
  }
  .a11y__desc {
    font-family: var(--font-body);
    font-size: calc(0.78rem * var(--escala-texto, 1));
    line-height: 1.5;
    color: var(--color-ink-soft);
    max-width: 26rem;
  }

  /* Slider de tamanho de fonte */
  .a11y__controle-fonte {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .a11y__trilho-fonte {
    position: relative;
    display: flex;
    align-items: center;
    width: 8rem;
  }
  /* Risco que marca onde fica o tamanho padrão (16px = 2/14 do percurso). */
  .a11y__marca-padrao {
    position: absolute;
    top: 50%;
    left: calc(0.7rem + (100% - 1.4rem) * 0.142857);
    width: 2px;
    height: 0.95rem;
    transform: translate(-50%, -50%);
    background: var(--color-ink-soft);
    border-radius: 1px;
    pointer-events: none;
  }
  .a11y__slider-fonte {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 5px;
    -webkit-appearance: none;
    appearance: none;
    background: linear-gradient(
      to right,
      var(--color-ink-soft),
      var(--color-ink)
    );
    border-radius: 999px;
    outline: none;
    cursor: pointer;
  }
  .a11y__slider-fonte::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--color-ink);
    border: 2px solid var(--color-paper);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    transition: transform 0.15s var(--ease);
  }
  .a11y__slider-fonte::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }
  .a11y__slider-fonte::-moz-range-thumb {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--color-ink);
    border: 2px solid var(--color-paper);
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    transition: transform 0.15s var(--ease);
  }
  .a11y__slider-fonte::-moz-range-thumb:hover {
    transform: scale(1.15);
  }
  .a11y__fonte-display {
    font-family: var(--font-display);
    font-size: calc(0.85rem * var(--escala-texto, 1));
    font-weight: 700;
    color: var(--color-ink);
    white-space: nowrap;
    text-align: center;
  }
  .a11y__restaurar {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.9rem;
  }
  .a11y__restaurar .painel__botao:disabled {
    opacity: 0.5;
    cursor: default;
  }

  /* Interruptor: é um <button role="switch">, então teclado e leitor de tela
     já entendem o estado por aria-checked. O visual só acompanha. */
  .a11y__chave {
    position: relative;
    flex-shrink: 0;
    width: 3rem;
    height: 1.7rem;
    padding: 0;
    border: 1px solid var(--color-controle);
    border-radius: 999px;
    background: var(--color-paper-dark);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .a11y__bolinha {
    position: absolute;
    top: 50%;
    left: 3px;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 999px;
    background: var(--color-surface);
