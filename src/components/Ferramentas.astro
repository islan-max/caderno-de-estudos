---
// Barra de ferramentas do cabeçalho.
// Substitui a antiga frase solta por quatro funções de verdade:
// buscar aula, ver progresso, trocar o tema e ajustar o tamanho do texto.
import Icone from './Icone.astro';
---

<div class="ferramentas" role="group" aria-label="Ferramentas do caderno">
  <button
    type="button"
    class="ferramenta ferramenta--busca"
    data-acao="busca"
    title="Buscar aula (Ctrl + K)"
    aria-label="Buscar aula"
    aria-haspopup="dialog"
    aria-keyshortcuts="Control+K"
  >
    <Icone nome="magnifying-glass" />
    <span class="ferramenta__texto">Buscar aula</span>
    <kbd class="ferramenta__atalho">Ctrl K</kbd>
  </button>

  <button type="button" class="ferramenta" data-abre="progresso" title="Meu progresso" aria-label="Meu progresso" aria-haspopup="dialog">
    <Icone nome="chart-simple" />
    <span class="ferramenta__texto ferramenta__texto--md">Progresso</span>
  </button>

  <button
    type="button"
    class="ferramenta"
    data-acao="acessibilidade"
    title="Acessibilidade"
    aria-label="Opções de acessibilidade"
    aria-haspopup="dialog"
  >
    <Icone nome="universal-access" />
  </button>

  <button
    type="button"
    class="tema-switch"
    data-acao="tema"
    aria-pressed="false"
    title="Usar o tema escuro"
    aria-label="Tema escuro"
  >
    <Icone nome="sun" class="tema-switch__icone tema-switch__icone--sol" />
    <Icone nome="moon" class="tema-switch__icone tema-switch__icone--lua" />
    <span class="tema-switch__bolha" aria-hidden="true"></span>
  </button>
</div>

<style>
  .ferramentas {
    /* Uma só altura e um só arredondamento para a fileira inteira: botões, busca e
       chave de tema ocupam a mesma faixa vertical, todos em pílula (o de
       acessibilidade, com largura igual à altura, vira um círculo). */
    /* Um pouco mais grossa que a faixa da pauta (35px): passa das duas linhas, mas o
       centro da barra fica no centro da faixa (ver o margin-top em Base.astro). */
    --altura: 2.35rem;
    --raio: 999px;
    --icone: calc(0.92rem * var(--escala-texto, 1));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .ferramentas :is(.ferramenta, .tema-switch) i {
    font-size: var(--icone);
    line-height: 1;
  }

  .ferramenta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: var(--altura);
    min-width: var(--altura);
    padding: 0 0.6rem;
    border-radius: var(--raio);
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 88%, var(--color-paper));
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: calc(0.8rem * var(--escala-texto, 1));
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }
  .ferramenta:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
    background: var(--color-surface);
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }
  .ferramenta:active {
    transform: translateY(0);
  }
  .ferramenta[aria-pressed='true'] {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 40%, var(--color-line));
  }

  /* A busca é a ação principal: ganha largura e vira um campo falso. */
  .ferramenta--busca {
    padding-right: 0.4rem;
    padding-left: 0.85rem;
  }
  .ferramenta__texto {
    display: none;
  }
  .ferramenta__atalho {
    display: none;
    font-family: var(--font-display);
    font-size: calc(0.62rem * var(--escala-texto, 1));
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.24rem 0.42rem;
    border-radius: 0.4rem;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-paper-dark) 55%, transparent);
    color: var(--color-ink-soft);
  }

  /* Escala do "Aa": o botão indica visualmente o nível ativo. */
  .ferramenta[data-nivel='grande'] {
    font-size: calc(0.88rem * var(--escala-texto, 1));
    color: var(--color-ink);
  }
  .ferramenta[data-nivel='maior'] {
    font-size: calc(0.96rem * var(--escala-texto, 1));
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 40%, var(--color-line));
  }

  @media (min-width: 640px) {
    .ferramentas {
      gap: 0.45rem;
    }
    .ferramenta--busca {
      min-width: 12.5rem;
      justify-content: flex-start;
    }
    .ferramenta--busca .ferramenta__texto {
      display: inline;
      flex: 1;
      text-align: left;
    }
    .ferramenta__atalho {
      display: inline-block;
    }
  }
  @media (min-width: 1024px) {
    .ferramenta__texto--md {
      display: inline;
    }
  }

  /* -------------------------------------------------------- interruptor de tema
     Mesma altura e mesmo raio dos outros botões. O trilho tem duas metades iguais
     (sol | lua) e a bolha ocupa exatamente uma delas: deslocar 100% da própria
     largura a leva à outra metade, sem conta de rem para destoar do desenho. */
  .tema-switch {
    --inset: 0.22rem;
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    place-items: center;
    width: 4.7rem;
    min-width: 4.7rem;
    height: var(--altura);
    padding: 0 var(--inset);
    border-radius: var(--raio);
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 7%, var(--color-surface));
    cursor: pointer;
    flex-shrink: 0;
  }
  .tema-switch:hover {
    border-color: color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
    box-shadow: var(--shadow-soft);
  }
  .tema-switch__icone {
    position: relative;
    z-index: 1;
    color: var(--color-ink-soft);
    /* 0,8 mantém o ícone do lado "desligado" com 3:1 de contraste (WCAG 1.4.11). */
    opacity: 0.8;
    /* O ícone apagado encolhe e gira um pouco; o aceso volta ao tamanho cheio. */
    transform: scale(0.82) rotate(var(--giro, -70deg));
    transition: color 0.3s var(--ease), opacity 0.3s var(--ease),
      transform 0.55s cubic-bezier(0.34, 1.5, 0.5, 1);
  }
  .tema-switch__icone--lua {
    --giro: 40deg;
  }
  /* O sol é o lado "ligado" no tema claro; a lua, no escuro. O outro ícone
     fica visível, só apagado — ninguém precisa adivinhar que ali tem um sol. */
  .tema-switch[aria-pressed='false'] .tema-switch__icone--sol {
    color: #8a6200;
    opacity: 1;
    transform: none;
  }
  .tema-switch[aria-pressed='true'] .tema-switch__icone--lua {
    color: var(--color-escolar);
    opacity: 1;
    transform: none;
  }
  .tema-switch__bolha {
    position: absolute;
    left: var(--inset);
    top: var(--inset);
    bottom: var(--inset);
    width: calc((100% - 2 * var(--inset)) / 2);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    /* Curva com leve passada do ponto: a bolha "assenta" no lado novo. */
    transition: transform 0.5s cubic-bezier(0.34, 1.4, 0.5, 1), background-color 0.4s var(--ease);
  }
  .tema-switch[aria-pressed='true'] .tema-switch__bolha {
    transform: translateX(100%);
    background: var(--color-paper-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .tema-switch__bolha,
    .tema-switch__icone {
      transition: color 0.2s, opacity 0.2s, background-color 0.2s;
    }
    .tema-switch__icone {
      transform: none;
    }
  }
  :global(html[data-movimento='sim']) .tema-switch__bolha,
  :global(html[data-movimento='sim']) .tema-switch__icone {
    transition: color 0.2s, opacity 0.2s, background-color 0.2s;
  }
  :global(html[data-movimento='sim']) .tema-switch__icone {
    transform: none;
  }
</style>
