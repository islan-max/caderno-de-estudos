---
// Barra de ferramentas do cabeçalho.
// Substitui a antiga frase solta por quatro funções de verdade:
// buscar aula, ver progresso, trocar o tema e ajustar o tamanho do texto.
import Icone from './Icone.astro';
---

<div class="ferramentas" role="group" aria-label="Ferramentas do caderno">
  <button
    type="button"
    class="ferramenta ferramenta--busca"
    data-acao="busca"
    title="Buscar aula (Ctrl + K)"
    aria-label="Buscar aula"
    aria-haspopup="dialog"
    aria-keyshortcuts="Control+K"
  >
    <Icone nome="magnifying-glass" />
    <span class="ferramenta__texto">Buscar aula</span>
    <kbd class="ferramenta__atalho">Ctrl K</kbd>
  </button>

  <button type="button" class="ferramenta" data-abre="progresso" title="Meu progresso" aria-label="Meu progresso" aria-haspopup="dialog">
    <Icone nome="chart-simple" />
    <span class="ferramenta__texto ferramenta__texto--md">Progresso</span>
  </button>

  <button
    type="button"
    class="ferramenta"
    data-acao="acessibilidade"
    title="Acessibilidade"
    aria-label="Opções de acessibilidade"
    aria-haspopup="dialog"
  >
    <Icone nome="universal-access" />
  </button>

  <button
    type="button"
    class="tema-switch"
    data-acao="tema"
    aria-pressed="false"
    title="Usar o tema escuro"
    aria-label="Tema escuro"
  >
    <Icone nome="sun" class="tema-switch__icone tema-switch__icone--sol" />
    <Icone nome="moon" class="tema-switch__icone tema-switch__icone--lua" />
    <span class="tema-switch__bolha" aria-hidden="true"></span>
  </button>
</div>

<style>
  .ferramentas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .ferramenta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 2.35rem;
    min-width: 2.35rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 88%, var(--color-paper));
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
  }
  .ferramenta:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
    background: var(--color-surface);
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }
  .ferramenta:active {
    transform: translateY(0);
  }
  .ferramenta[aria-pressed='true'] {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 40%, var(--color-line));
  }

  /* A busca é a ação principal: ganha largura e vira um campo falso. */
  .ferramenta--busca {
    padding-right: 0.4rem;
    padding-left: 0.85rem;
  }
  .ferramenta__texto {
    display: none;
  }
  .ferramenta__atalho {
    display: none;
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.24rem 0.42rem;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-paper-dark) 55%, transparent);
    color: var(--color-ink-soft);
  }

  /* Escala do "Aa": o botão indica visualmente o nível ativo. */
  .ferramenta[data-nivel='grande'] {
    font-size: 0.88rem;
    color: var(--color-ink);
  }
  .ferramenta[data-nivel='maior'] {
    font-size: 0.96rem;
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 40%, var(--color-line));
  }

  @media (min-width: 640px) {
    .ferramentas {
      gap: 0.45rem;
    }
    .ferramenta--busca {
      min-width: 12.5rem;
      justify-content: flex-start;
    }
    .ferramenta--busca .ferramenta__texto {
      display: inline;
      flex: 1;
      text-align: left;
    }
    .ferramenta__atalho {
      display: inline-block;
    }
  }
  @media (min-width: 1024px) {
    .ferramenta__texto--md {
      display: inline;
    }
  }

  /* -------------------------------------------------------- interruptor de tema
     Trilho com sol e lua nas pontas e uma bolha que desliza entre eles — o
     mesmo gesto de um interruptor físico. Some as duas larguras (trilho e
     bolha) e a folga (--inset) para o cálculo do deslocamento nunca destoar
     do que está desenhado. */
  .tema-switch {
    --trilho-w: 3.5rem;
    --trilho-h: 1.9rem;
    --bolha: 1.5rem;
    --inset: 0.2rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: var(--trilho-w);
    min-width: var(--trilho-w);
    height: var(--trilho-h);
    padding: 0 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 7%, var(--color-surface));
    cursor: pointer;
    flex-shrink: 0;
  }
  .tema-switch:hover {
    border-color: color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
    box-shadow: var(--shadow-soft);
  }
  .tema-switch__icone {
    position: relative;
    z-index: 1;
    font-size: 0.76rem;
    color: var(--color-ink-soft);
    /* 0,8 mantém o ícone do lado "desligado" com 3:1 de contraste (WCAG 1.4.11). */
    opacity: 0.8;
    transition: color 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  /* O sol é o lado "ligado" no tema claro; a lua, no escuro. O outro ícone
     fica visível, só apagado — ninguém precisa adivinhar que ali tem um sol. */
  .tema-switch[aria-pressed='false'] .tema-switch__icone--sol {
    color: #8a6200;
    opacity: 1;
  }
  .tema-switch[aria-pressed='true'] .tema-switch__icone--lua {
    color: var(--color-escolar);
    opacity: 1;
  }
  .tema-switch__bolha {
    position: absolute;
    left: var(--inset);
    top: var(--inset);
    width: var(--bolha);
    height: var(--bolha);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
    transition: transform 0.32s var(--ease), background-color 0.32s var(--ease);
  }
  .tema-switch[aria-pressed='true'] .tema-switch__bolha {
    transform: translateX(calc(var(--trilho-w) - var(--bolha) - 2 * var(--inset)));
    background: var(--color-paper-dark);
  }
  @media (prefers-reduced-motion: reduce) {
    .tema-switch__bolha {
      transition: background-color 0.32s var(--ease);
    }
  }
</style>
