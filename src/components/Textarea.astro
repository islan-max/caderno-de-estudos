---
// Folha de redação das aulas de Redação.
//
// Imita a folha oficial: linhas pautadas e numeradas de 1 a 30, com a marca
// do mínimo de 7 linhas. Conta palavras e linhas enquanto o aluno escreve e
// guarda o rascunho só neste navegador (localStorage), para ele não perder o
// texto ao recarregar. A correção ainda não existe: o botão fica visível e
// desabilitado, avisando que vem depois.
//
// No MDX chega pelo mapa de componentes de [tema].astro, sem import:
//
//   <Textarea id="proposta-de-intervencao" titulo="Escreva sua proposta de intervenção" />
//
// A folha tem tamanho FIXO: 30 linhas, sem crescer e sem o aluno poder esticá-la. O que passa
// das 30 linhas (digitando, colando ou apertando Enter) é recusado, como na folha de papel.
// Clicar numa linha vazia mais abaixo leva o cursor até lá, sem precisar de Enter.
//
// A contagem de linhas é aproximada: depende da largura da tela, e a folha
// do ENEM tem largura fixa.
import Icone from './Icone.astro';

interface Props {
  /** Nome único na aula: vira a chave do rascunho guardado. */
  id: string;
  titulo?: string;
  /** Uma linha curta sob o título, dizendo o que escrever. */
  dica?: string;
  linhas?: number;
  minimo?: number;
}
const {
  id,
  titulo = 'Sua redação',
  dica = 'Escreva aqui. O rascunho fica guardado neste navegador.',
  linhas = 30,
  minimo = 7,
} = Astro.props;
const campo = `redacao-${id}`;
---

<section class="folha not-prose" data-folha={id} data-linhas={linhas} data-minimo={minimo} style={`--linhas: ${linhas};`}>
  <header class="folha__cabeca">
    <span class="folha__icone"><Icone nome="feather-pointed" duo cor="var(--folha-tinta)" /></span>
    <span class="folha__textos">
      <label class="folha__titulo" for={campo}>{titulo}</label>
      <span class="folha__dica" id={`${campo}-dica`}>{dica}</span>
    </span>
  </header>

  <div class="folha__papel">
    <ol class="folha__numeros" aria-hidden="true">
      {Array.from({ length: linhas }, (_, i) => (
        <li class:list={{ 'folha__numero--minimo': i + 1 === minimo }}>{i + 1}</li>
      ))}
    </ol>
    <textarea
      id={campo}
      class="folha__campo"
      rows={linhas}
      spellcheck="true"
      autocomplete="off"
      aria-describedby={`${campo}-dica ${campo}-contagem`}
      placeholder="Comece pelo primeiro parágrafo…"
    ></textarea>
  </div>

  <footer class="folha__rodape">
    <p class="folha__contagem" id={`${campo}-contagem`}>
      <span data-folha-linhas>0 de {linhas} linhas</span>
      <span class="folha__ponto" aria-hidden="true">·</span>
      <span data-folha-palavras>0 palavras</span>
      <!-- Aviso em texto: a cor do contador sozinha não basta (WCAG 1.4.1). -->
      <span class="folha__aviso" data-folha-aviso></span>
      <span class="folha__estado" data-folha-estado role="status"></span>
    </p>
    <div class="folha__acoes">
      <button type="button" class="folha__botao" data-folha-limpar>
        <Icone nome="rotate-left" /> Limpar
      </button>
      <button type="button" class="folha__botao folha__botao--principal" disabled title="A correção automática ainda está sendo construída">
        <Icone nome="wand-magic-sparkles" /> Enviar para correção
        <span class="folha__selo">em breve</span>
      </button>
    </div>
  </footer>
</section>

<script>
  const CHAVE = 'cdt:redacao:';

  function lerRascunho(id: string): string {
    try {
      return localStorage.getItem(CHAVE + location.pathname + ':' + id) ?? '';
    } catch {
      return '';
    }
  }
  function guardarRascunho(id: string, texto: string): boolean {
    try {
      const k = CHAVE + location.pathname + ':' + id;
      if (texto) localStorage.setItem(k, texto);
      else localStorage.removeItem(k);
      return true;
    } catch {
      return false;
    }
  }

  function montar(folha: HTMLElement) {
    if (folha.dataset.pronta === 'true') return;
    folha.dataset.pronta = 'true';
    const id = folha.dataset.folha!;
    const total = Number(folha.dataset.linhas);
    const minimo = Number(folha.dataset.minimo);
    const campo = folha.querySelector<HTMLTextAreaElement>('textarea')!;
    const rotLinhas = folha.querySelector<HTMLElement>('[data-folha-linhas]')!;
    const rotPalavras = folha.querySelector<HTMLElement>('[data-folha-palavras]')!;
    const estado = folha.querySelector<HTMLElement>('[data-folha-estado]')!;
    const aviso = folha.querySelector<HTMLElement>('[data-folha-aviso]')!;
    const limpar = folha.querySelector<HTMLButtonElement>('[data-folha-limpar]')!;
    let espera = 0;

    // Linhas ocupadas = altura do texto / altura de uma linha. A medida é feita
    // num "espelho" invisível, fora do fluxo, com a mesma largura e fonte. O campo de
    // verdade tem altura fixa (as 30 linhas da folha, no CSS) e nunca muda de tamanho.
    const espelho = campo.cloneNode() as HTMLTextAreaElement;
    espelho.removeAttribute('id');
    espelho.setAttribute('aria-hidden', 'true');
    espelho.tabIndex = -1;
    espelho.style.cssText = 'position:absolute;visibility:hidden;pointer-events:none;left:0;top:0;height:0;min-height:0;';
    campo.parentElement!.appendChild(espelho);

    function alturaDaLinha(): number {
      return parseFloat(getComputedStyle(campo).lineHeight);
    }

    /** Quantas linhas (já com a quebra automática) um texto ocupa neste campo. */
    function contarLinhas(texto: string): number {
      if (!texto) return 0;
      const estilo = getComputedStyle(campo);
      const pad = parseFloat(estilo.paddingTop) + parseFloat(estilo.paddingBottom);
      espelho.style.width = campo.clientWidth + 'px';
      espelho.value = texto;
      return Math.max(1, Math.round((espelho.scrollHeight - pad) / alturaDaLinha()));
    }

    function medir() {
      // Linhas em branco no fim não contam como escritas.
      const escrito = campo.value.replace(/\s+$/, '');
      const usadas = contarLinhas(escrito);

      const palavras = campo.value.trim() ? campo.value.trim().split(/\s+/).length : 0;
      rotLinhas.textContent = usadas + ' de ' + total + ' linhas';
      rotPalavras.textContent = palavras + (palavras === 1 ? ' palavra' : ' palavras');
      const situacao = usadas === 0 ? 'vazia' : usadas < minimo ? 'curta' : 'ok';
      folha.dataset.situacao = situacao;
      aviso.textContent =
        situacao === 'curta'
          ? 'abaixo do mínimo de ' + minimo + ' linhas'
          : situacao === 'ok'
            ? 'dentro do limite'
            : '';
    }

    // Último texto aceito (com a posição do cursor): é para onde se volta quando uma
    // tecla tentaria passar das 30 linhas.
    let ultimo = { valor: '', ini: 0, fim: 0 };
    function lembrar() {
      ultimo = { valor: campo.value, ini: campo.selectionStart, fim: campo.selectionEnd };
    }

    /** Maior começo do texto que cabe nas linhas da folha. */
    function cortarParaCaber(texto: string): string {
      let ini = 0;
      let fim = texto.length;
      while (ini < fim) {
        const meio = Math.ceil((ini + fim) / 2);
        if (contarLinhas(texto.slice(0, meio)) <= total) ini = meio;
        else fim = meio - 1;
      }
      return texto.slice(0, ini);
    }

    /** Devolve true se passou do limite e o texto foi corrigido. */
    function respeitarLimite(tipo: string): boolean {
      if (contarLinhas(campo.value) <= total) return false;
      if (tipo === 'insertText' || tipo === 'insertLineBreak' || tipo === 'insertParagraph') {
        // Uma tecla só: recusa, o texto fica como estava.
        campo.value = ultimo.valor;
        campo.setSelectionRange(ultimo.ini, ultimo.fim);
      } else {
        // Colar ou arrastar texto grande: fica o que cabe.
        campo.value = cortarParaCaber(campo.value);
        campo.setSelectionRange(campo.value.length, campo.value.length);
      }
      estado.textContent = 'limite de ' + total + ' linhas da folha';
      return true;
    }

    campo.value = lerRascunho(id);
    if (contarLinhas(campo.value) > total) campo.value = cortarParaCaber(campo.value);
    medir();
    lembrar();

    function salvar() {
      estado.textContent = 'salvando…';
      clearTimeout(espera);
      espera = window.setTimeout(() => {
        estado.textContent = guardarRascunho(id, campo.value) ? 'rascunho salvo' : '';
      }, 500);
    }

    campo.addEventListener('input', (e) => {
      const limitou = respeitarLimite((e as InputEvent).inputType ?? '');
      medir();
      lembrar();
      if (!limitou) salvar();
    });
    // A seleção muda sem o texto mudar (setas, clique): o cursor guardado acompanha.
    document.addEventListener('selectionchange', () => {
      if (document.activeElement === campo && campo.value === ultimo.valor) lembrar();
    });

    // Folha de papel: clicar numa linha vazia, abaixo do que já foi escrito, põe o cursor lá.
    // O texto ganha as quebras de linha que faltam, como se o aluno tivesse apertado Enter.
    // Clicar no meio de uma linha, ou selecionar texto, continua do jeito nativo.
    campo.addEventListener('click', (e) => {
      if (e.detail === 0 || campo.selectionStart !== campo.selectionEnd) return;
      const lh = alturaDaLinha();
      const alvo = Math.min(total - 1, Math.floor((e.clientY - campo.getBoundingClientRect().top) / lh));
      const ocupadas = Math.max(1, contarLinhas(campo.value));
      if (alvo <= ocupadas - 1) return;
      campo.value += '\n'.repeat(alvo - (ocupadas - 1));
      campo.setSelectionRange(campo.value.length, campo.value.length);
      medir();
      lembrar();
      salvar();
    });

    limpar.addEventListener('click', async () => {
      if (campo.value.trim()) {
        // confirm() nativo é bloqueado em alguns navegadores: usa a janela da própria página.
        const pedir = (window as unknown as { cdtConfirmar?: (p: object) => Promise<{ ok: boolean }> }).cdtConfirmar;
        const ok = pedir
          ? (
              await pedir({
                titulo: 'Apagar o texto desta folha?',
                texto: 'Tudo o que você escreveu nesta folha será apagado deste navegador. Isso não pode ser desfeito.',
                confirmar: 'Apagar texto',
              })
            ).ok
          : confirm('Apagar o texto desta folha?');
        if (!ok) return;
      }
      campo.value = '';
      guardarRascunho(id, '');
      estado.textContent = '';
      medir();
      lembrar();
      campo.focus();
    });

    // No celular, a barra de endereço some ao rolar e dispara "resize" sem mudar
    // a largura: só vale medir de novo quando a largura muda de fato.
    let largura = campo.clientWidth;
    window.addEventListener('resize', () => {
      if (campo.clientWidth === largura) return;
      largura = campo.clientWidth;
      medir();
    });
  }

  function iniciar() {
    document.querySelectorAll<HTMLElement>('[data-folha]').forEach(montar);
  }
  iniciar();
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .folha {
    --folha-tinta: var(--materia, var(--color-enem));
    --folha-linha: 2rem;
    margin: 2rem 0 0;
    border: 1px solid color-mix(in srgb, var(--folha-tinta) 28%, var(--color-line));
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--folha-tinta) 5%, var(--color-surface));
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .folha__cabeca {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1rem 0.8rem 0.9rem;
  }
  .folha__icone {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.1rem;
    height: 2.1rem;
    font-size: calc(0.9rem * var(--escala-texto, 1));
  }
  .folha__textos {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .folha__titulo {
    font-family: var(--font-display);
    font-size: calc(0.72rem * var(--escala-texto, 1));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--folha-tinta);
  }
  .folha__dica {
    font-family: var(--font-body);
    font-size: calc(0.86rem * var(--escala-texto, 1));
    line-height: 1.4;
    color: var(--color-ink-soft);
  }

  /* ------------------------------------------------------------- o papel */
  .folha__papel {
    position: relative;
    display: flex;
    margin: 0 0.75rem;
    /* Sem borda embaixo: a última linha da pauta faz esse papel (ver .folha__campo). */
    border: 1px solid var(--color-controle);
    border-bottom-width: 0;
    border-radius: 0.5rem;
    background: var(--color-surface);
    overflow: hidden;
  }
  /* O campo tira o contorno do navegador: o anel (2px, sólido) vai na folha inteira. */
  .folha__papel:focus-within {
    border-color: var(--folha-tinta);
    outline: 2px solid var(--color-escolar);
    outline-offset: 2px;
  }

  /* A pauta é uma só, da borda de cima à de baixo: cada linha mede exatamente --folha-linha,
     sem folga no topo nem no fim, e a numeração e o campo usam a mesma régua. */
  .folha__numeros {
    flex-shrink: 0;
    width: 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-right: 2px solid color-mix(in srgb, var(--folha-tinta) 35%, transparent);
    background: color-mix(in srgb, var(--color-paper-dark) 22%, var(--color-surface));
    overflow: hidden;
  }
  .folha__numeros li {
    box-sizing: border-box;
    height: var(--folha-linha);
    line-height: calc(var(--folha-linha) - 1px);
    padding-right: 0.45rem;
    text-align: right;
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 75%, transparent);
    font-family: var(--font-display);
    font-size: calc(0.66rem * var(--escala-texto, 1));
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-soft);
  }
  .folha__numeros li:last-child {
    border-bottom-color: var(--color-controle);
  }
  /* Linha 7: o mínimo para a redação não ser zerada. */
  .folha__numeros li.folha__numero--minimo {
    color: var(--folha-tinta);
    opacity: 1;
    font-weight: 800;
  }

  .folha__campo {
    flex: 1;
    min-width: 0;
    display: block;
    box-sizing: border-box;
    /* Altura FIXA: exatamente as linhas da folha. Não cresce com o texto e não é redimensionável. */
    height: calc(var(--linhas) * var(--folha-linha));
    margin: 0;
    padding: 0 0.9rem;
    border: 0;
    outline: none;
    resize: none !important;
    overflow: hidden;
    background-color: transparent;
    /* Pauta: uma linha no pé de cada linha. A última, que fecha o papel, usa a cor da borda. */
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--folha-linha) - 1px),
      color-mix(in srgb, var(--color-line) 75%, transparent) calc(var(--folha-linha) - 1px),
      color-mix(in srgb, var(--color-line) 75%, transparent) var(--folha-linha)
    );
    box-shadow: inset 0 -1px 0 var(--color-controle);
    font-family: var(--font-body);
    font-size: calc(1rem * var(--escala-texto, 1));
    line-height: var(--folha-linha);
    color: var(--color-ink);
    caret-color: var(--folha-tinta);
    cursor: text;
  }
  .folha__campo::placeholder {
    color: var(--color-ink-soft);
    opacity: 1;
  }

  /* ------------------------------------------------------------- rodapé */
  .folha__rodape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    padding: 0.8rem 1rem 0.95rem;
  }
  .folha__contagem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(0.78rem * var(--escala-texto, 1));
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .folha[data-situacao='curta'] [data-folha-linhas] {
    color: var(--color-enem);
  }
  .folha[data-situacao='ok'] [data-folha-linhas] {
    color: var(--color-ok);
  }
  .folha[data-situacao='longa'] [data-folha-linhas] {
    color: var(--color-enem);
  }
  .folha__aviso:not(:empty)::before {
    content: '·';
    margin-right: 0.4rem;
  }
  .folha__estado {
    font-weight: 500;
    font-style: italic;
  }
  .folha__estado:not(:empty)::before {
    content: '·';
    margin-right: 0.4rem;
    font-style: normal;
  }

  .folha__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .folha__botao {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: calc(0.8rem * var(--escala-texto, 1));
    font-weight: 700;
    cursor: pointer;
  }
  .folha__botao:hover:not(:disabled) {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
    background: var(--color-paper-dark);
  }
  .folha__botao--principal {
    border-color: color-mix(in srgb, var(--folha-tinta) 45%, var(--color-line));
    color: var(--folha-tinta);
  }
  .folha__botao:disabled {
    cursor: not-allowed;
    opacity: 0.75;
  }
  .folha__selo {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--folha-tinta) 14%, transparent);
    font-size: calc(0.62rem * var(--escala-texto, 1));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 480px) {
    .folha__papel {
      margin: 0 0.4rem;
    }
    .folha__numeros {
      width: 1.8rem;
    }
    .folha__campo {
      padding-inline: 0.6rem;
    }
  }
</style>
