---
// Lista de aulas em ordem de aprendizado, de cima para baixo.
//
// O número à esquerda é a posição na trilha; quando a aula já foi vista ele
// vira um "check" e o item recebe data-vista="true" (aplicado em JS a partir
// do armazenamento local). A diferença é discreta de propósito: o item
// continua legível e clicável, só perde o destaque de "pendente".
import Icone from './Icone.astro';

// Só o que a trilha usa. `pronta: false` mostra a aula como "Em breve" (ou `aviso`), sem link
// e fora do progresso: o que não está disponível não pode ser clicado.
interface ItemTrilha {
  id: string;
  titulo: string;
  resumo: string;
  href: string;
  pronta?: boolean;
  /** Texto no lugar do número da posição (ex.: R1 numa revisão). */
  marca?: string;
  /** Selo da aula sem link (padrão: "Em breve"), ex.: "Sem material". */
  aviso?: string;
}

interface Props {
  aulas: ItemTrilha[];
  accent?: string;
}
const { aulas, accent = 'enem' } = Astro.props;
---

<ol class="trilha" style={`--accent: var(--color-${accent});`}>
  {aulas.map((aula, i) => (
    <li class="trilha__item" data-aula-id={aula.pronta === false ? undefined : aula.id} style={`--i: ${i}`} data-surgir>
      {aula.pronta === false ? (
        <div class="trilha__link trilha__link--breve">
          <span class="trilha__marca" aria-hidden="true">
            <span class="trilha__numero">{aula.marca ?? String(i + 1).padStart(2, '0')}</span>
          </span>
          <span class="trilha__corpo">
            <span class="trilha__titulo">{aula.titulo}</span>
            <span class="trilha__resumo">{aula.resumo}</span>
          </span>
          <span class="trilha__breve">{aula.aviso ?? 'Em breve'}</span>
        </div>
      ) : (
        <a href={aula.href} class="trilha__link">
          <span class="trilha__marca" aria-hidden="true">
            <circle-progress class="trilha__anel" value="0" max="100" text-format="none"></circle-progress>
            <span class="trilha__numero">{aula.marca ?? String(i + 1).padStart(2, '0')}</span>
            <Icone nome="check" class="trilha__check" />
          </span>
          <span class="trilha__corpo">
            <span class="trilha__titulo">{aula.titulo}</span>
            <span class="trilha__resumo">{aula.resumo}</span>
            <!-- A marca de "vista" é só um ícone: o texto abaixo leva a mesma informação
                 ao leitor de tela. Quem o preenche é refletirProgresso() em app.ts. -->
            <span class="apenas-leitor" data-vista-texto></span>
          </span>
          <span class="trilha__ir">
            <span class="trilha__ir-texto">Abrir</span>
            <Icone nome="arrow-right" />
          </span>
        </a>
      )}
    </li>
  ))}
</ol>

<style>
  .trilha {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    counter-reset: aula;
  }

  .trilha__item {
    position: relative;
    isolation: isolate;
  }
  /* Fio ligando os passos da trilha.
     z-index 0 contra z-index 1 do cartão: o fio passa POR TRÁS do cartão e só
     aparece no vão entre um passo e o outro. Antes ele cruzava o cartão inteiro
     por cima, porque o fundo do cartão era semitransparente. */
  .trilha__item:not(:last-child)::before {
    content: '';
    position: absolute;
    z-index: 0;
    left: calc(1.825rem - 1px);
    top: 1rem;
    bottom: -0.75rem;
    width: 2px;
    border-radius: 2px;
    background: var(--color-line);
  }
  /* O fio acompanha o progresso: verde no trecho já concluído. */
  .trilha__item[data-vista='true']:not(:last-child)::before {
    background: color-mix(in srgb, var(--color-ok) 65%, var(--color-line));
  }

  .trilha__link {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 0.7rem;
    /* Fundo opaco (mistura com a folha, não com transparente) para o cartão
       cobrir o fio da trilha em vez de deixá-lo transparecer. */
    background: color-mix(in srgb, var(--color-paper-dark) 22%, var(--color-surface));
    text-decoration: none;
    color: var(--color-ink);
  }
  .trilha__link:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--color-surface));
    transform: translateX(3px);
    box-shadow: var(--shadow-soft);
  }

  .trilha__marca {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: var(--color-surface);
    font-family: var(--font-display);
    font-size: calc(0.7rem * var(--escala-texto, 1));
    font-weight: 700;
    color: var(--color-ink-soft);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .trilha__marca > * {
    grid-area: 1 / 1;
  }
  /* Anel de andamento: a borda do círculo é uma barra de progresso circular (componente
     js-circle-progress, SVG vetorial). O arco, na cor da matéria, cresce com o quanto da aula já
     foi feito (leitura e questões, ver refletirProgresso em app.ts); o resto do anel fica na cor
     de trilho. Cheio e verde quando concluída. */
  .trilha__anel {
    position: absolute;
    inset: -1px;
    display: block;
  }
  .trilha__anel::part(base) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .trilha__anel::part(circle) {
    stroke: color-mix(in srgb, var(--color-ink) 16%, transparent);
    stroke-width: 9;
  }
  .trilha__anel::part(value) {
    stroke: var(--anel-cor, var(--accent));
    stroke-width: 9;
    stroke-linecap: round;
  }
  /* Sem andamento não há arco: o traço de comprimento zero com ponta redonda viraria um ponto. */
  .trilha__anel[value='0']::part(value) {
    visibility: hidden;
  }
  .trilha__check {
    font-size: calc(0.72rem * var(--escala-texto, 1));
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .trilha__numero {
    transition: opacity 0.2s var(--ease);
  }

  .trilha__corpo {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
    padding-top: 0.1rem;
  }
  .trilha__titulo {
    font-family: var(--font-display);
    font-size: calc(0.98rem * var(--escala-texto, 1));
    font-weight: 650;
    line-height: 1.3;
  }
  .trilha__resumo {
    font-family: var(--font-body);
    font-size: calc(0.82rem * var(--escala-texto, 1));
    line-height: 1.5;
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .trilha__ir {
    display: none;
    align-items: center;
    gap: 0.4rem;
    align-self: center;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: calc(0.7rem * var(--escala-texto, 1));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.24s var(--ease), transform 0.24s var(--ease);
  }
  .trilha__link:hover .trilha__ir,
  .trilha__link:focus-visible .trilha__ir {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 700px) {
    .trilha__ir {
      display: inline-flex;
    }
  }

  /* Aula ainda não escrita ou sem material: aparece na trilha, sem link e mais apagada. */
  .trilha__link--breve {
    cursor: default;
    border-style: dashed;
  }
  /* Sem opacity: ela derrubaria o contraste do texto abaixo de 4,5:1. A pista de
     "ainda não disponível" é a borda tracejada, o texto "Em breve" e a cor suave. */
  .trilha__link--breve .trilha__titulo {
    color: var(--color-ink-soft);
  }
  .trilha__link--breve:hover {
    border-color: var(--color-line);
    background: color-mix(in srgb, var(--color-paper-dark) 22%, var(--color-surface));
    transform: none;
    box-shadow: none;
  }
  .trilha__breve {
    align-self: center;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: calc(0.66rem * var(--escala-texto, 1));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
  }

  /* ------------------------------------------------------------- vista
     Sutil: o cartão perde saturação, o número vira check verde e um filete
     na lateral confirma a conclusão. Nada de tachado ou cinza berrante. */
  .trilha__item[data-vista='true'] .trilha__link {
    background: var(--color-surface);
    border-color: color-mix(in srgb, var(--color-ok) 28%, var(--color-line));
  }
  .trilha__item[data-vista='true'] .trilha__link::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--color-ok);
    opacity: 0.75;
  }
  .trilha__item[data-vista='true'] .trilha__titulo {
    color: var(--color-ink-soft);
    font-weight: 600;
  }
  .trilha__item[data-vista='true'] .trilha__marca {
    --anel-cor: var(--color-ok);
    background: color-mix(in srgb, var(--color-ok) 16%, var(--color-surface));
    color: var(--color-ok);
  }
  .trilha__item[data-vista='true'] .trilha__numero {
    opacity: 0;
  }
  .trilha__item[data-vista='true'] .trilha__check {
    opacity: 1;
    transform: none;
  }
</style>
