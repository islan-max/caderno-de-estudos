---
// "Ferramentas para esta aula": o que instalar, criar ou ter à mão para acompanhar e praticar.
//
// Vem do campo `ferramentas` do frontmatter da aula (ver src/content.config.ts) e reaproveita
// o Accordion: fica recolhido junto do Raio-X e do glossário, e o cabeçalho já mostra os nomes
// do que é preciso, para ninguém abrir só para descobrir se tem a ver.
import Accordion from './Accordion.astro';
import Icone from './Icone.astro';

interface Ferramenta {
  nome: string;
  uso: string;
  custo?: string;
  link?: string;
  opcional: boolean;
}
interface Props {
  ferramentas: Ferramenta[];
}
const { ferramentas } = Astro.props;

const essenciais = ferramentas.filter((f) => !f.opcional);
const opcionais = ferramentas.filter((f) => f.opcional);

// Dica do cabeçalho: os nomes do que é preciso (ou, se tudo é opcional, o que há de opcional).
const nomes = (essenciais.length ? essenciais : opcionais).map((f) => f.nome);
const dica =
  nomes.length > 4 ? `${nomes.slice(0, 4).join(', ')} e mais ${nomes.length - 4}` : nomes.join(', ');
---

<Accordion titulo="Ferramentas para esta aula" dica={dica} icone="list-check" rolagem={false}>
  {essenciais.length > 0 && (
    <>
      <p class="ferr__grupo">Para acompanhar a aula</p>
      <ul class="ferr">
        {essenciais.map((f) => (
          <li>
            {f.link ? (
              <a class="ferr__nome" href={f.link} target="_blank" rel="noopener noreferrer">
                {f.nome}
                <Icone nome="up-right-from-square" class="ferr__externo" />
                <span class="apenas-leitor"> (abre em nova aba)</span>
              </a>
            ) : (
              <span class="ferr__nome">{f.nome}</span>
            )}
            {f.custo && <span class="ferr__custo">{f.custo}</span>}
            <span class="ferr__uso">{f.uso}</span>
          </li>
        ))}
      </ul>
    </>
  )}
  {opcionais.length > 0 && (
    <>
      <p class="ferr__grupo">Opcionais</p>
      <ul class="ferr">
        {opcionais.map((f) => (
          <li>
            {f.link ? (
              <a class="ferr__nome" href={f.link} target="_blank" rel="noopener noreferrer">
                {f.nome}
                <Icone nome="up-right-from-square" class="ferr__externo" />
                <span class="apenas-leitor"> (abre em nova aba)</span>
              </a>
            ) : (
              <span class="ferr__nome">{f.nome}</span>
            )}
            {f.custo && <span class="ferr__custo">{f.custo}</span>}
            <span class="ferr__uso">{f.uso}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</Accordion>

<style>
  .ferr__grupo {
    margin: 0 0 0.2rem;
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-ink-soft);
  }
  .ferr + .ferr__grupo {
    margin-top: 1.1rem;
  }
  .ferr__nome {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
  a.ferr__nome {
    color: var(--color-escolar);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a.ferr__nome:hover {
    color: var(--color-ink);
  }
  .ferr__externo {
    margin-left: 0.3em;
    font-size: 0.65em;
  }
  .ferr__custo {
    display: inline-block;
    margin: 0 0.4rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .ferr__uso {
    display: block;
    margin-top: 0.1rem;
    color: var(--color-ink);
  }
</style>
