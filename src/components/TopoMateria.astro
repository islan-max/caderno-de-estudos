---
// Topo da página de uma matéria (ENEM, Escolar, DS): ícone, nome, andamento e a dica da trilha.
// O andamento (data-progresso-de) conta só as aulas que já existem.
import Icone from './Icone.astro';

interface Props {
  nome: string;
  icone: string;
  /** Rótulo pequeno acima do nome (a área do ENEM, o bimestre…). */
  area?: string;
  /** Cor da matéria: uma variável CSS, ex.: var(--color-fisica). */
  cor: string;
  /** Ids (progresso local) das aulas que existem. */
  ids: string[];
  /** Linha de ajuda abaixo do andamento. */
  dica: string;
}
const { nome, icone, area, cor, ids, dica } = Astro.props;
---

<div style={`--materia: ${cor};`}>
  <header class="materia-topo" data-surgir>
    <div class="materia-topo__titulo">
      <Icone nome={icone} duo cor={cor} class="materia-topo__icone" />
      <div>
        {area && <p class="materia-topo__area">{area}</p>}
        <h1 class="materia-topo__h1">{nome}</h1>
      </div>
    </div>

    <div class="materia-progresso" data-progresso-de={ids.join(' ')}>
      <div class="materia-progresso__cabeca">
        <span class="materia-progresso__rotulo">
          <Icone nome="list-check" /> Seu progresso nesta matéria
        </span>
        <span class="materia-progresso__num"><span data-progresso-texto>0 de {ids.length}</span></span>
      </div>
      <div class="materia-progresso__trilho" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label={`Progresso em ${nome}`}>
        <span data-progresso-barra></span>
      </div>
    </div>
  </header>

  <p class="materia-dica" data-surgir style="--i: 1">
    <Icone nome="signs-post" />
    {dica}
  </p>
</div>

<style>
  .materia-topo {
    margin-bottom: 1.75rem;
  }
  .materia-topo__titulo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.35rem;
  }
  .materia-topo__icone {
    font-size: calc(1.15rem * var(--escala-texto, 1));
    flex-shrink: 0;
  }
  .materia-topo__area {
    font-family: var(--font-display);
    font-size: calc(0.64rem * var(--escala-texto, 1));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
    margin: 0 0 0.2rem;
  }
  .materia-topo__h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }

  .materia-progresso {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--color-paper-dark) 28%, transparent);
  }
  .materia-progresso[data-completo='true'] {
    border-color: color-mix(in srgb, var(--color-ok) 45%, transparent);
    background: color-mix(in srgb, var(--color-ok) 8%, transparent);
  }
  .materia-progresso__cabeca {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }
  .materia-progresso__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: calc(0.68rem * var(--escala-texto, 1));
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-soft);
  }
  .materia-progresso__num {
    font-family: var(--font-display);
    font-size: calc(0.78rem * var(--escala-texto, 1));
    font-weight: 700;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .materia-progresso__trilho {
    height: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    overflow: hidden;
  }
  .materia-progresso__trilho span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--materia, var(--color-enem)), var(--color-ok));
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.75s var(--ease);
  }

  .materia-dica {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: calc(0.82rem * var(--escala-texto, 1));
    color: var(--color-ink-soft);
    margin: 0 0 1rem;
  }
</style>
