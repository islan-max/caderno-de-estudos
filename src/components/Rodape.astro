---
import { u } from '../lib/url';
import Icone from './Icone.astro';

const ano = new Date().getFullYear();

// Rótulo curto na tela; o nome completo vai no aria-label e no title.
const legais = [
  { href: '/privacidade', curto: 'Privacidade', label: 'Política de Privacidade' },
  { href: '/termos', curto: 'Termos', label: 'Termos de Uso' },
  { href: '/lgpd', curto: 'LGPD', label: 'Conformidade com a LGPD' },
  { href: '/uso-de-ia', curto: 'Uso de IA', label: 'Uso de IA' },
  { href: '/acessibilidade', curto: 'Acessibilidade', label: 'Declaração de acessibilidade' },
];
---

<footer class="rodape">
  <div class="rodape__conteudo">
    <!-- Uma faixa só, como no rodapé do GitHub: marca e ano, documentos, criador. -->
    <div class="rodape__linha">
      <p class="rodape__marca">
        © {ano} Caderno de Estudos<span style="color: var(--color-enem)">.</span>
      </p>

      <nav aria-label="Documentos legais">
        <ul class="rodape__lista">
          {legais.map((l) => (
            <li>
              <a href={u(l.href)} aria-label={l.label} title={l.label}>{l.curto}</a>
            </li>
          ))}
        </ul>
      </nav>

      <p class="rodape__assinatura">
        <a class="rodape__assinatura-link" href={u('/criador')}>
          Área do criador <Icone nome="arrow-right" />
        </a>
      </p>
    </div>

    <p class="rodape__nota">
      Biblioteca de estudo aberta e gratuita, publicada por <strong>Islan Max</strong> sob licença
      MIT. Material de apoio, sem vínculo com o INEP, o MEC ou qualquer instituição de ensino.
    </p>
  </div>
</footer>

<style>
  .rodape {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 72%, var(--color-paper));
  }
  .rodape__conteudo {
    max-width: 64rem;
    margin: 0 auto;
    width: 100%;
    padding: 1rem 0.75rem 1rem;
  }
  @media (min-width: 640px) {
    .rodape__conteudo {
      padding-inline: 1rem;
    }
  }
  @media (min-width: 768px) {
    .rodape__conteudo {
      padding: 1.1rem 2.5rem 1.1rem;
    }
  }

  /* Faixa única: quebra em linhas só quando não cabe. */
  .rodape__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.25rem;
  }

  .rodape__marca {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(0.85rem * var(--escala-texto, 1));
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .rodape__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
  }
  .rodape__lista a {
    font-family: var(--font-body);
    font-size: calc(0.8rem * var(--escala-texto, 1));
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .rodape__lista a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Assinatura do criador: uma linha simples, com um toque de cor no link. */
  .rodape__assinatura {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: calc(0.8rem * var(--escala-texto, 1));
    color: var(--color-ink-soft);
  }
  .rodape__nota strong {
    color: var(--color-ink);
    font-weight: 800;
  }
  .rodape__assinatura-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-enem);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }
  .rodape__assinatura-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rodape__assinatura-link :global(i) {
    font-size: 0.8em;
    transition: transform 0.2s var(--ease);
  }
  .rodape__assinatura-link:hover :global(i) {
    transform: translateX(3px);
  }

  /* Aviso de independência: pequeno e discreto, numa linha (ou duas em tela estreita). */
  .rodape__nota {
    margin: 0.7rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-body);
    font-size: calc(0.72rem * var(--escala-texto, 1));
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
</style>
