---
import { u } from '../lib/url';
import Icone from './Icone.astro';

const ano = new Date().getFullYear();

const legais = [
  { href: '/privacidade', label: 'Política de Privacidade', icone: 'user-shield' },
  { href: '/termos', label: 'Termos de Uso', icone: 'file-contract' },
  { href: '/lgpd', label: 'Conformidade com a LGPD', icone: 'scale-balanced' },
  { href: '/uso-de-ia', label: 'Uso de IA', icone: 'robot' },
];
---

<footer class="rodape">
  <div class="rodape__conteudo">
    <div class="rodape__grade">
      <!-- Institucional -->
      <section class="rodape__bloco rodape__bloco--marca">
        <p class="rodape__marca">
          Caderno de Estudos<span style="color: var(--color-enem)">.</span>
        </p>
        <p class="rodape__descricao">
          Biblioteca de estudo aberta e gratuita, mantida de forma independente por <strong>Islan
          Max</strong>. Material de apoio, sem vínculo com o INEP, o MEC ou qualquer instituição de
          ensino — não substitui a orientação de um professor responsável.
        </p>
      </section>

      <!-- Legal -->
      <nav class="rodape__bloco" aria-label="Documentos legais">
        <h2 class="rodape__titulo">Política e termos</h2>
        <ul class="rodape__lista">
          {legais.map((l) => (
            <li>
              <a href={u(l.href)}>
                <Icone nome={l.icone} class="rodape__icone" />
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Redes -->
      <nav class="rodape__bloco" aria-label="Redes sociais">
        <h2 class="rodape__titulo">Onde me achar</h2>
        <ul class="rodape__lista">
          <li>
            <a href="https://github.com/islan-max" target="_blank" rel="noopener noreferrer me">
              <Icone nome="github" marca class="rodape__icone" />
              @islan-max
              <Icone nome="up-right-from-square" class="rodape__externo" />
            </a>
          </li>
          <li>
            <a href="https://instagram.com/islan.max" target="_blank" rel="noopener noreferrer me">
              <Icone nome="instagram" marca class="rodape__icone" />
              @islan.max
              <Icone nome="up-right-from-square" class="rodape__externo" />
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p class="rodape__base">
      © {ano} Caderno de Estudos · Islan Max. Conteúdo educacional sob licença MIT.
    </p>
  </div>
</footer>

<style>
  .rodape {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-surface) 72%, var(--color-paper));
  }
  .rodape__conteudo {
    max-width: 64rem;
    margin: 0 auto;
    width: 100%;
    padding: 1.75rem 0.75rem 1.25rem;
  }
  @media (min-width: 640px) {
    .rodape__conteudo {
      padding-inline: 1rem;
    }
  }
  @media (min-width: 768px) {
    .rodape__conteudo {
      padding: 2rem 2.5rem 1.4rem;
    }
  }

  /* Três colunas em telas médias pra cima: a marca fica com o dobro da largura
     das duas listas, que são curtas. */
  .rodape__grade {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .rodape__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rodape__bloco--marca {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 880px) {
    .rodape__grade {
      grid-template-columns: 2fr 1.1fr 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    .rodape__bloco--marca {
      grid-column: auto;
    }
  }

  .rodape__marca {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.45rem;
  }
  .rodape__descricao {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
    max-width: 34rem;
  }
  .rodape__descricao strong {
    color: var(--color-ink);
    font-weight: 800;
  }

  .rodape__titulo {
    font-family: var(--font-display);
    font-size: 0.64rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    margin: 0 0 0.6rem;
  }
  .rodape__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rodape__lista a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .rodape__lista a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rodape__icone {
    font-size: 0.8em;
    opacity: 0.7;
    width: 1.1em;
  }
  .rodape__externo {
    font-size: 0.6em;
    opacity: 0.45;
  }

  .rodape__base {
    margin: 1.5rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: 0.7rem;
    color: var(--color-ink-soft);
    text-align: center;
  }
</style>
