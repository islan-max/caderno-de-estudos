---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import TabNav from '../components/TabNav.astro';
import Ferramentas from '../components/Ferramentas.astro';
import Paineis from '../components/Paineis.astro';
import Rodape from '../components/Rodape.astro';
import Icone from '../components/Icone.astro';
import { u } from '../lib/url';
import interLatin from '../assets/fonts/inter-normal-latin.woff2';
import nunitoLatin from '../assets/fonts/nunito-normal-latin.woff2';

interface Props {
  title: string;
  active?: 'hub' | 'enem' | 'escolar' | 'ds' | null;
  description?: string;
  /** Botão explícito de "voltar" no topo da folha, sempre um nível acima. */
  voltar?: { href: string; label: string };
  /** Esconde a folha pautada (usado por páginas de texto puro). */
  larga?: boolean;
  /** Cor da borda da folha e da aba ativa quando a página é de uma matéria (ex.: var(--color-historia)). */
  cor?: string;
}
const {
  title,
  active = null,
  description = 'Aulas organizadas para estudar no seu ritmo',
  voltar,
  cor,
} = Astro.props;

// A borda da folha segue a cor da aba ativa (o hub usa o mesmo "preto" da aba Início).
const accentByTab: Record<string, string> = {
  hub: 'var(--color-ink)',
  enem: 'var(--color-enem)',
  escolar: 'var(--color-escolar)',
  ds: 'var(--color-ds)',
};
// Nas páginas de uma matéria, a folha (e a aba) ganham a cor da matéria, como a
// divisória colorida de um fichário.
const borderColor = cor ?? (active ? accentByTab[active] : 'var(--color-line)');
---

<!doctype html>
<html lang="pt-BR" data-base={u('/') || '/'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Caderno de Estudos</title>
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="icon" href={u('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#edeadf" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Caderno de Estudos" />
    <meta property="og:title" content={`${title} · Caderno de Estudos`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={u('/icon-512.png')} />
    <meta name="twitter:card" content="summary" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interLatin.src}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={nunitoLatin.src}
      crossorigin
    />
    <ClientRouter />
    <script is:inline>
      // Aplica tema e tamanho de texto salvos ANTES do primeiro paint (sem flash).
      (function () {
        try {
          var raiz = document.documentElement;
          var tema = JSON.parse(localStorage.getItem('cdt:tema') || '""');
          var texto = JSON.parse(localStorage.getItem('cdt:texto') || '""');
          if (tema === 'escuro') {
            raiz.dataset.tema = 'escuro';
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#0d0f14');
          }
          if (texto === 'grande' || texto === 'maior') raiz.dataset.texto = texto;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Barra fina de progresso de leitura, no topo da janela. -->
    <div class="leitura" aria-hidden="true"><i data-leitura></i></div>

    <a href="#conteudo" class="pular">Pular para o conteúdo</a>

    <!-- Miniatura da marca: entra quando a marca grande sai da tela e sai
         quando ela volta. Quem controla é um IntersectionObserver, não a
         posição de rolagem — assim não há cálculo por quadro. -->
    <a href={u('/')} class="marca-mini" data-marca-mini aria-hidden="true" tabindex="-1">
      <span class="marca-mini__texto">CE</span>
      <span class="marca-mini__ponto">.</span>
    </a>

    <!-- O topo troca sem animar: cruzar duas versões da marca e das abas
         deixaria um "fantasma" durante a transição. -->
    <header class="cabecalho" data-cabecalho transition:animate="none">
      <div class="cabecalho__linha">
        <a href={u('/')} class="marca" data-marca>
          Caderno de Estudos<span class="marca__ponto">.</span>
        </a>
        <Ferramentas />
      </div>

      <div class="max-w-5xl mx-auto w-full mt-5 sm:mt-6">
        <TabNav active={active} corAtiva={cor} />
      </div>
    </header>

    <main
      class="flex-1 max-w-5xl mx-auto w-full px-3 sm:px-4 md:px-10"
      id="conteudo"
      aria-label="Conteúdo principal"
      transition:animate={fade({ duration: '0.12s' })}
    >
      <div
        class="paper-sheet min-h-[60vh] p-4 pl-10 sm:p-6 sm:pl-12 md:p-10 md:pl-16 -mt-[2px]"
        style={`border-color: ${borderColor};`}
      >
        {voltar && (
          <a href={voltar.href} class="voltar" data-pager="anterior">
            <span class="voltar__seta"><Icone nome="arrow-left" /></span>
            <span class="voltar__texto">
              <span class="voltar__rotulo">Voltar para</span>
              <span class="voltar__destino">{voltar.label}</span>
            </span>
          </a>
        )}
        <slot />
      </div>
    </main>

    <Rodape transition:animate="none" />

    <div id="toasts" transition:persist aria-live="polite"></div>
    <Paineis />

    <script>
      import '../scripts/app';
    </script>

    <style>
      /* ------------------------------------------------------------ topo */
      .leitura {
        position: fixed;
        inset: 0 0 auto 0;
        height: 3px;
        z-index: 80;
        pointer-events: none;
      }
      .leitura i {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--color-enem), var(--color-escolar));
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform 0.12s linear;
      }

      /* ------------------------------------------------ miniatura da marca */
      .marca-mini {
        position: fixed;
        top: 0.85rem;
        left: 0.85rem;
        z-index: 70;
        display: inline-flex;
        align-items: baseline;
        gap: 1px;
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        background: var(--color-surface);
        box-shadow: var(--shadow-soft);
        color: var(--color-ink);
        font-family: var(--font-display);
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1;
        text-decoration: none;
        /* Estado de repouso: escondida. Só opacity e transform mudam, então a
           entrada e a saída são feitas pelo compositor. */
        opacity: 0;
        transform: translateY(-8px) scale(0.94);
        pointer-events: none;
        transition: opacity 0.22s var(--ease), transform 0.22s var(--ease);
      }
      .marca-mini[data-visivel='true'] {
        opacity: 1;
        transform: none;
        pointer-events: auto;
      }
      .marca-mini:hover {
        border-color: color-mix(in srgb, var(--color-ink) 35%, var(--color-line));
      }
      .marca-mini__ponto {
        color: var(--color-enem);
      }

      .pular {
        position: absolute;
        left: -999px;
        top: 0;
        z-index: 100;
        padding: 0.6rem 1rem;
        background: var(--color-ink);
        color: var(--color-paper);
        font-family: var(--font-display);
        font-size: 0.8rem;
        border-radius: 0 0 0.5rem 0;
      }
      .pular:focus {
        left: 0;
      }

      /* ---------------------------------------------------------- cabeçalho
         O padding-top é fixo e casado com --rule-offset (global.css) para que
         a linha de base da marca caia exatamente sobre uma linha da pauta —
         a marca fica "escrita" sobre o papel, não atravessada por ele. */
      .cabecalho {
        padding-top: 56px;
      }
      .cabecalho__linha {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        max-width: 64rem;
        margin: 0 auto;
        width: 100%;
        padding-inline: 0.75rem;
      }
      /* Em telas estreitas a marca sozinha já ocupa a linha: as ferramentas
         descem para a linha de baixo em vez de espremer ou vazar. */
      @media (max-width: 559px) {
        .cabecalho__linha {
          flex-wrap: wrap;
          justify-content: flex-start;
          row-gap: 0;
        }
        .cabecalho__linha > :global(.ferramentas) {
          width: 100%;
          margin-bottom: 0.5rem;
        }
      }
      @media (min-width: 640px) {
        .cabecalho__linha {
          padding-inline: 1rem;
        }
      }
      @media (min-width: 768px) {
        .cabecalho__linha {
          padding-inline: 2.5rem;
        }
      }

      .marca {
        font-family: var(--font-display);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--color-ink);
        text-decoration: none;
        white-space: nowrap;
        /* Caixa de linha com altura de 2 pautas: a marca ocupa a pauta certa. */
        font-size: 26px;
        line-height: 70px;
        display: inline-block;
        transition: color 0.2s var(--ease), opacity 0.2s var(--ease);
      }
      .marca:hover {
        opacity: 0.78;
      }
      .marca__ponto {
        color: var(--color-enem);
      }
      @media (min-width: 640px) {
        .marca {
          font-size: 32px;
        }
      }
      @media (min-width: 768px) {
        .marca {
          font-size: 38px;
        }
      }

      /* -------------------------------------------------------- botão voltar */
      .voltar {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.5rem;
        padding: 0.45rem 0.95rem 0.45rem 0.5rem;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        text-decoration: none;
        color: var(--color-ink-soft);
        background: color-mix(in srgb, var(--color-paper-dark) 40%, transparent);
      }
      .voltar:hover {
        color: var(--color-ink);
        border-color: color-mix(in srgb, var(--color-ink) 30%, var(--color-line));
        background: var(--color-paper-dark);
      }
      .voltar__seta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 999px;
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        font-size: 0.7rem;
        transition: transform 0.22s var(--ease);
      }
      .voltar:hover .voltar__seta {
        transform: translateX(-3px);
      }
      .voltar__texto {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
      }
      .voltar__rotulo {
        font-family: var(--font-display);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.7;
      }
      .voltar__destino {
        font-family: var(--font-display);
        font-size: 0.85rem;
        font-weight: 600;
      }

      /* ------------------------------------------------------------- folha
         Folha estilo fichário: borda na cor da aba ativa e furos perfurados na
         margem esquerda. z-index 5 deixa a folha na frente das abas inativas
         (que ficam "coladas" nas folhas de trás) e atrás da aba ativa (z 30). */
      .paper-sheet {
        position: relative;
        z-index: 5;
        border-width: 2px;
        border-style: solid;
        border-radius: 0 0.6rem 0.6rem 0;
        background-color: var(--color-surface);
        box-shadow: var(--shadow-soft);
        transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease),
          box-shadow 0.35s var(--ease);
      }
      /* Furos: recuados 12px do topo/base pra nunca encostar na borda;
         background-repeat "space" distribui furos inteiros, sem cortar nenhum.
         Três camadas por furo: miolo na cor do fundo da página (o "vazado"),
         sombra interna no topo e brilho na base — efeito de papel perfurado. */
      .paper-sheet::before {
        content: '';
        position: absolute;
        top: 12px;
        bottom: 12px;
        left: 8px;
        width: 18px;
        pointer-events: none;
        background-image:
          radial-gradient(circle 5px at 9px 20px, var(--color-paper) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 18.5px, rgba(31, 42, 68, 0.32) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 21.5px, rgba(255, 255, 255, 0.8) 99%, transparent 100%);
        background-size: 18px 40px;
        background-repeat: no-repeat space;
      }
      :global(html[data-tema='escuro']) .paper-sheet::before {
        background-image:
          radial-gradient(circle 5px at 9px 20px, var(--color-paper) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 18.5px, rgba(0, 0, 0, 0.55) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 21.5px, rgba(255, 255, 255, 0.07) 99%, transparent 100%);
      }
    </style>
  </body>
</html>
