---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import TabNav from '../components/TabNav.astro';
import Ferramentas from '../components/Ferramentas.astro';
import CabecalhoFixo from '../components/CabecalhoFixo.astro';
import Paineis from '../components/Paineis.astro';
import Rodape from '../components/Rodape.astro';
import Icone from '../components/Icone.astro';
import { u } from '../lib/url';
import interLatin from '../assets/fonts/inter-normal-latin.woff2';
import nunitoLatin from '../assets/fonts/nunito-normal-latin.woff2';
import faSolid from '../assets/fonts/fa-solid-900.woff2';

interface Props {
  title: string;
  active?: 'hub' | 'enem' | 'escolar' | 'ds' | null;
  description?: string;
  /** Botão explícito de "voltar" no topo da folha, sempre um nível acima. */
  voltar?: { href: string; label: string };
  /** Esconde a folha pautada (usado por páginas de texto puro). */
  larga?: boolean;
  /** Cor da borda da folha e da aba ativa quando a página é de uma matéria (ex.: var(--color-historia)). */
  cor?: string;
}
const {
  title,
  active = null,
  description = 'Aulas organizadas para estudar no seu ritmo',
  voltar,
  cor,
} = Astro.props;

// A borda da folha segue a cor da aba ativa (o hub usa o mesmo "preto" da aba Início).
const accentByTab: Record<string, string> = {
  hub: 'var(--color-ink)',
  enem: 'var(--color-enem)',
  escolar: 'var(--color-escolar)',
  ds: 'var(--color-ds)',
};
// Nas páginas de uma matéria, a folha (e a aba) ganham a cor da matéria, como a
// divisória colorida de um fichário.
const borderColor = cor ?? (active ? accentByTab[active] : 'var(--color-line)');
---

<!doctype html>
<html lang="pt-BR" data-base={u('/') || '/'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Caderno de Estudos</title>
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="icon" href={u('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#edeadf" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Caderno de Estudos" />
    <meta property="og:title" content={`${title} · Caderno de Estudos`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={u('/icon-512.png')} />
    <meta name="twitter:card" content="summary" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={interLatin.src}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={nunitoLatin.src}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={faSolid.src}
      crossorigin
    />
    <ClientRouter />
    <script is:inline>
      // Aplica tema, tamanho de fonte e brilho salvos ANTES do primeiro paint (sem flash).
      (function () {
        try {
          var raiz = document.documentElement;
          var tema = JSON.parse(localStorage.getItem('cdt:tema') || '""');
          var fontePx = JSON.parse(localStorage.getItem('cdt:fonte-px') || '16');
          if (tema === 'escuro') {
            raiz.dataset.tema = 'escuro';
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#0d0f14');
          }
          var disp = JSON.parse(localStorage.getItem('cdt:dispensados') || '[]');
          if (disp && disp.length) raiz.dataset.dispensados = disp.join(' ');
          var px = Math.max(14, Math.min(28, Number(fontePx) || 16));
          raiz.style.setProperty('--escala-texto', String(px / 16));
          var brilho = Math.max(75, Math.min(100, Number(JSON.parse(localStorage.getItem('cdt:brilho') || '100')) || 100));
          if (brilho < 100) {
            raiz.dataset.brilho = 'sim';
            raiz.style.setProperty('--brilho', String(brilho / 100));
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col" style={`--acento: ${borderColor};`}>
    <a href="#conteudo" class="pular">Pular para o conteúdo</a>

    <!-- Voltar ao topo: entra junto com os marcadores fixos (quando a marca grande sai
         da tela) e sai quando ela volta. Fora de vista não recebe foco nem leitor de tela. -->
    <button
      type="button"
      class="topo"
      data-topo
      data-acao="topo"
      aria-hidden="true"
      tabindex="-1"
      aria-label="Voltar ao topo da página"
      title="Voltar ao topo"
    >
      <Icone nome="arrow-up" />
    </button>

    <!-- O topo troca sem animar: cruzar duas versões da marca e das abas
         deixaria um "fantasma" durante a transição. -->
    <header class="cabecalho" data-cabecalho transition:animate="none">
      <div class="cabecalho__linha">
        <a href={u('/')} class="marca" data-marca>
          Caderno de Estudos<span class="marca__ponto">.</span>
        </a>
        <Ferramentas />
      </div>

      <div class="max-w-5xl mx-auto w-full mt-5 sm:mt-6" data-abas>
        <TabNav active={active} corAtiva={cor} />
      </div>
    </header>

    <main
      class="flex-1 max-w-5xl mx-auto w-full px-3 sm:px-4 md:px-10"
      id="conteudo"
      tabindex="-1"
      transition:animate="none"
    >
      <div
        class="paper-sheet min-h-[60vh] p-4 pl-10 sm:p-6 sm:pl-12 md:p-10 md:pl-16 -mt-[2px]"
        style={`border-color: ${borderColor};`}
      >
        <CabecalhoFixo active={active} corAtiva={cor} />
        {voltar && (
          <a href={voltar.href} class="voltar" data-pager="anterior">
            <span class="voltar__seta"><Icone nome="arrow-left" /></span>
            <span class="voltar__texto">
              <span class="voltar__rotulo">Voltar para</span>
              <span class="voltar__destino">{voltar.label}</span>
            </span>
          </a>
        )}
        <slot />
      </div>
    </main>

    <Rodape transition:animate="none" />

    <!-- Região viva única: cada toast novo é anunciado uma vez, sem role próprio. -->
    <div id="toasts" transition:persist role="status" aria-live="polite"></div>
    <Paineis />

    <script>
      import '../scripts/app';
    </script>

    <style>
      /* --------------------------------------------------- voltar ao topo */
      .topo {
        position: fixed;
        right: 2.25rem;
        bottom: 1.25rem;
        z-index: 70;
        display: grid;
        place-items: center;
        width: 2.9rem;
        height: 2.9rem;
        border: 1px solid var(--color-line);
        border-radius: 999px;
        background: var(--color-surface);
        box-shadow: var(--shadow-lift);
        color: var(--color-ink);
        font-size: calc(1rem * var(--escala-texto, 1));
        cursor: pointer;
        /* Repouso: escondido. Só opacity e transform mudam (compositor). */
        opacity: 0;
        transform: translateY(10px) scale(0.92);
        pointer-events: none;
        transition: opacity 0.22s var(--ease), transform 0.22s var(--ease),
          border-color 0.2s var(--ease), background-color 0.2s var(--ease);
      }
      .topo[data-visivel='true'] {
        opacity: 1;
        transform: none;
        pointer-events: auto;
      }
      .topo:hover {
        border-color: var(--color-ink);
        background: var(--color-paper-dark);
      }
      .topo:hover :global(i) {
        transform: translateY(-2px);
      }
      .topo :global(i) {
        transition: transform 0.2s var(--ease);
      }
      @media (max-width: 639px) {
        .topo {
          right: 1rem;
          bottom: 1rem;
        }
      }
      @media print {
        .topo {
          display: none;
        }
      }

      .pular {
        position: absolute;
        left: -999px;
        top: 0;
        z-index: 100;
        padding: 0.6rem 1rem;
        background: var(--color-ink);
        color: var(--color-paper);
        font-family: var(--font-display);
        font-size: calc(0.8rem * var(--escala-texto, 1));
        border-radius: 0 0 0.5rem 0;
      }
      .pular:focus {
        left: 0;
      }

      /* ---------------------------------------------------------- cabeçalho
         O padding-top é fixo e casado com --rule-offset (global.css) para que
         a linha de base da marca caia exatamente sobre uma linha da pauta —
         a marca fica "escrita" sobre o papel, não atravessada por ele. */
      .cabecalho {
        padding-top: 56px;
        /* O cabeçalho e o <main> têm cada um um view-transition-name (transition:animate),
           o que cria um contexto de empilhamento para cada. Sem z-index aqui, o <main>
           (que vem depois) pintaria a folha inteira por cima das abas, e a aba ativa não
           conseguiria cobrir a borda de cima da folha. */
        position: relative;
        z-index: 6;
      }
      .cabecalho__linha {
        display: flex;
        /* Quebra de linha em qualquer largura: com o texto ampliado (ou o tamanho de fonte
           do navegador em 200%) a marca e as ferramentas não cabem lado a lado. */
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0 0.75rem;
        max-width: 64rem;
        margin: 0 auto;
        width: 100%;
        padding-inline: 0.75rem;
      }
      /* O centro da barra de ferramentas cai no centro de uma faixa da pauta (os 34px
         livres entre duas linhas); a barra é mais grossa que a faixa e passa um pouco das
         duas linhas, igual para cima e para baixo. O topo da faixa vem do deslocamento da
         pauta (--rule-offset, que muda por largura): o cabeçalho começa em 56px, que sobra
         21px no módulo de 35, e a faixa começa em --rule-offset + 35k; a diferença é 14px.
         Subtrai-se metade do excesso da barra sobre a faixa. Vale tanto ao lado da marca
         quanto quando a barra desce para a linha de baixo. */
      .cabecalho__linha > :global(.ferramentas) {
        align-self: flex-start;
        min-height: var(--altura);
        margin-top: calc(
          var(--rule-offset) + 14px - (var(--altura) - (var(--rule) - 1px)) / 2
        );
      }
      /* Em telas estreitas a marca sozinha já ocupa a linha: as ferramentas
         descem para a linha de baixo em vez de espremer ou vazar. */
      @media (max-width: 559px) {
        .cabecalho__linha {
          flex-wrap: wrap;
          justify-content: flex-start;
          row-gap: 0;
        }
        .cabecalho__linha > :global(.ferramentas) {
          width: 100%;
          margin-bottom: 0.5rem;
        }
      }
      @media (min-width: 640px) {
        .cabecalho__linha {
          padding-inline: 1rem;
        }
      }
      @media (min-width: 768px) {
        .cabecalho__linha {
          padding-inline: 2.5rem;
        }
      }

      .marca {
        font-family: var(--font-display);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--color-ink);
        text-decoration: none;
        white-space: nowrap;
        /* Caixa de linha com altura de 2 pautas: a marca ocupa a pauta certa. */
        font-size: 28px;
        --marca-ajuste: -1px;
        line-height: 70px;
        display: inline-block;
        /* O desenho do "C" começa um pouco depois da caixa do texto (~0.027em): puxa a marca
           para a esquerda para a letra encostar na borda da folha, junto da aba "Início". */
        margin-left: -0.027em;
        /* Sobe/desce a marca para a linha de base cair exatamente sobre uma linha da pauta
           (o ajuste muda com o tamanho da letra e com o deslocamento da pauta). */
        position: relative;
        top: var(--marca-ajuste, 0px);
        transition: color 0.2s var(--ease), opacity 0.2s var(--ease);
      }
      .marca:hover {
        opacity: 0.78;
      }
      .marca__ponto {
        color: var(--color-enem);
      }
      @media (min-width: 640px) {
        .marca {
          font-size: 36px;
          --marca-ajuste: -2px;
        }
      }
      @media (min-width: 768px) {
        /* 44px: as letras (altura do "C" ~32px) preenchem a faixa de 34px entre duas linhas. */
        .marca {
          font-size: 44px;
          --marca-ajuste: -2px;
        }
      }

      /* -------------------------------------------------------- link voltar
         Uma linha só, sem a pílula grande: "← Voltar para Início". Quando a página já tem o
         caminho de migalhas ("Você está aqui"), o link some da tela (o último nível do caminho
         vira o "voltar", ver global.css) e continua no HTML só para o atalho da seta ← do teclado. */
      .voltar {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem;
        padding: 0.15rem 0.6rem 0.15rem 0.15rem;
        border-radius: 999px;
        text-decoration: none;
        color: var(--color-ink-soft);
        font-family: var(--font-display);
        font-size: calc(0.8rem * var(--escala-texto, 1));
        line-height: 1.3;
      }
      .voltar:hover {
        color: var(--color-ink);
        background: color-mix(in srgb, var(--color-paper-dark) 45%, transparent);
      }
      .voltar__seta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 999px;
        border: 1px solid var(--color-line);
        background: var(--color-surface);
        font-size: calc(0.65rem * var(--escala-texto, 1));
        transition: transform 0.22s var(--ease);
      }
      .voltar:hover .voltar__seta {
        transform: translateX(-3px);
      }
      .voltar__rotulo {
        margin-right: 0.3em;
      }
      .voltar__destino {
        font-weight: 700;
        color: var(--color-ink);
      }


      /* ------------------------------------------------------------- folha
         Folha estilo fichário: borda na cor da aba ativa e furos perfurados na
         margem esquerda. z-index 5 deixa a folha na frente das abas inativas
         (que ficam "coladas" nas folhas de trás) e atrás da aba ativa (z 30). */
      .paper-sheet {
        position: relative;
        z-index: 5;
        border-width: 2px;
        border-style: solid;
        border-radius: 0 0.6rem 0.6rem 0;
        background-color: var(--color-surface);
        box-shadow: var(--shadow-soft);
        transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease),
          box-shadow 0.35s var(--ease);
      }
      /* Furos: recuados 12px do topo/base pra nunca encostar na borda;
         background-repeat "space" distribui furos inteiros, sem cortar nenhum.
         Três camadas por furo: miolo na cor do fundo da página (o "vazado"),
         sombra interna no topo e brilho na base — efeito de papel perfurado. */
      .paper-sheet::before {
        content: '';
        position: absolute;
        top: 12px;
        bottom: 12px;
        left: 8px;
        width: 18px;
        pointer-events: none;
        background-image:
          radial-gradient(circle 5px at 9px 20px, var(--color-paper) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 18.5px, rgba(31, 42, 68, 0.32) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 21.5px, rgba(255, 255, 255, 0.8) 99%, transparent 100%);
        background-size: 18px 40px;
        background-repeat: no-repeat space;
      }
      :global(html[data-tema='escuro']) .paper-sheet::before {
        background-image:
          radial-gradient(circle 5px at 9px 20px, var(--color-paper) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 18.5px, rgba(0, 0, 0, 0.55) 99%, transparent 100%),
          radial-gradient(circle 6px at 9px 21.5px, rgba(255, 255, 255, 0.07) 99%, transparent 100%);
      }
    </style>
  </body>
</html>
