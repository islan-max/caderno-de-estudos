---
import { secaoVisivel } from '../../../lib/secoes';
import Base from '../../../layouts/Base.astro';
import TopoMateria from '../../../components/TopoMateria.astro';
import BimestresMateria from '../../../components/BimestresMateria.astro';
import { u } from '../../../lib/url';
import { materiasDs } from '../../../lib/dsMapa';
import { contarAulas, iconeDaMateriaSecao, idsProntos } from '../../../lib/materiasSecoes';

export async function getStaticPaths() {
  // Seção oculta (src/lib/secoes.ts): nenhuma rota é gerada.
  if (!secaoVisivel('ds')) return [];
  return (await materiasDs()).map((m) => ({ params: { materia: m.slug } }));
}

const { materia: materiaSlug } = Astro.params;
const materia = (await materiasDs()).find((m) => m.slug === materiaSlug);
if (!materia) return Astro.redirect(u('/ds'));
const { total, prontas } = contarAulas(materia.bimestres);
---

<Base
  title={materia.nome}
  active="ds"
  description={`Aulas de ${materia.nome}, por bimestre`}
  voltar={{ href: u('/ds'), label: 'Matérias' }}
  cor={`var(--color-${materia.slug})`}
>
  <nav class="font-mono text-xs text-ink-soft mb-4" aria-label="Você está aqui">
    <a href={u('/ds')} class="hover:text-ink underline underline-offset-2">Desenvolvimento de Sistemas</a>
    <span> / </span>
    <span class="text-ink">{materia.nome}</span>
  </nav>

  <TopoMateria
    nome={materia.nome}
    icone={iconeDaMateriaSecao(materia.slug)}
    area="Desenvolvimento de Sistemas"
    cor={`var(--color-${materia.slug})`}
    ids={idsProntos(materia)}
    dica={`Cada bimestre traz as aulas na ordem. ${prontas} de ${total} já estão disponíveis; as marcadas como “Em breve” ou “Sem material” não abrem.`}
  />

  <div style={`--materia: var(--color-${materia.slug});`}>
    <BimestresMateria materia={materia} />
  </div>
</Base>
