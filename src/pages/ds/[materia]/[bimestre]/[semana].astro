---
import { secaoVisivel } from '../../../../lib/secoes';
import Tema from '../../../../layouts/Tema.astro';
import { getCollection, render } from 'astro:content';
import { bimestreLabel as bimLabelFn } from '../../../../lib/slug';
import { u } from '../../../../lib/url';

export async function getStaticPaths() {
  // Seção oculta (src/lib/secoes.ts): nenhuma rota é gerada.
  if (!secaoVisivel('ds')) return [];
  const aulas = await getCollection('ds');
  return aulas.map((aula) => {
    const [materia, bimestre, semana] = aula.id.split('/');
    return { params: { materia, bimestre, semana } };
  });
}

const { materia, bimestre, semana } = Astro.params;
const entries = await getCollection('ds');
const entry = entries.find((aula) => aula.id === `${materia}/${bimestre}/${semana}`);
if (!entry) return Astro.redirect(u('/ds'));
const Content = (await render(entry)).Content;
const subjectLabel = entry.data.subject;
---

<Tema
  title={entry.data.title}
  subject={subjectLabel}
  relevance={entry.data.relevance}
  quickSummary={entry.data.quickSummary}
  resources={entry.data.resources}
  active="ds"
  breadcrumb={[
    { label: 'Desenvolvimento de Sistemas', href: u('/ds') },
    { label: subjectLabel, href: u(`/ds/${materia}/`) },
    { label: bimLabelFn(bimestre ?? ''), href: u(`/ds/${materia}/${bimestre}/`) },
    { label: entry.data.title },
  ]}
>
  {Content && <Content />}
</Tema>
