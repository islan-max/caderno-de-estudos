---
import { secaoVisivel } from '../../../../lib/secoes';
import Base from '../../../../layouts/Base.astro';
import TrilhaAulas from '../../../../components/TrilhaAulas.astro';
import { u } from '../../../../lib/url';
import { materiasDs } from '../../../../lib/dsMapa';

export async function getStaticPaths() {
  // Seção oculta (src/lib/secoes.ts): nenhuma rota é gerada.
  if (!secaoVisivel('ds')) return [];
  return (await materiasDs()).flatMap((m) => m.bimestres.map((b) => ({ params: { materia: m.slug, bimestre: b.slug } })));
}

const { materia, bimestre } = Astro.params;
const mat = (await materiasDs()).find((m) => m.slug === materia);
const bim = mat?.bimestres.find((b) => b.slug === bimestre);
if (!mat || !bim) return Astro.redirect(u('/ds'));

// Cada aula junta todo o conteúdo da semana: a trilha mostra os tópicos como resumo.
const itens = bim.aulas.map((a) => ({
  id: a.id,
  titulo: a.titulo,
  resumo: a.topicos.join(' · '),
  href: u(`/ds/${mat.slug}/${bim.slug}/${a.slug}/`),
  pronta: a.pronta,
}));
---

<Base
  title={`${mat.nome} · ${bim.label}`}
  active="ds"
  description={`Aulas de ${mat.nome}, ${bim.label}`}
  voltar={{ href: u(`/ds/${mat.slug}/`), label: mat.nome }}
>
  <nav class="font-mono text-xs text-ink-soft mb-4 flex flex-wrap gap-1" aria-label="Você está aqui">
    <a href={u('/ds')} class="hover:text-ink underline underline-offset-2">Desenvolvimento de Sistemas</a>
    <span>/</span>
    <a href={u(`/ds/${mat.slug}/`)} class="hover:text-ink underline underline-offset-2">{mat.nome}</a>
    <span>/</span>
    <span class="text-ink">{bim.label}</span>
  </nav>
  <h1 class="font-display text-3xl md:text-4xl font-bold text-ink mb-8">{bim.label}</h1>

  <TrilhaAulas aulas={itens} accent="ds" />
</Base>
