---
import SecaoOculta from '../../components/SecaoOculta.astro';
import { secaoVisivel } from '../../lib/secoes';
import Base from '../../layouts/Base.astro';
import TopoSecao from '../../components/TopoSecao.astro';
import AreaMaterias from '../../components/AreaMaterias.astro';
import { materiasDs } from '../../lib/dsMapa';
import { contarAulas, grupoDaSecao, idsProntos } from '../../lib/materiasSecoes';

// Seção oculta (src/lib/secoes.ts): a rota continua existindo (links antigos não
// quebram), mas some da navegação e não gera nenhuma página interna.
const oculta = !secaoVisivel('ds');

const materias = await materiasDs();
const grupo = grupoDaSecao('ds', 'Desenvolvimento de Sistemas', 'code', materias);
const porMateria = new Map(materias.map((m) => [m.slug, idsProntos(m)]));
const emBreve = new Map(
  materias.map((m) => {
    const { total, prontas } = contarAulas(m.bimestres);
    return [m.slug, total - prontas] as const;
  })
);
---

<Base title="Desenvolvimento de Sistemas" active="ds" description="Aulas de Desenvolvimento de Sistemas, por matéria e bimestre">
  {oculta ? (
    <SecaoOculta nome="Desenvolvimento de Sistemas" />
  ) : (
    <Fragment>
      <TopoSecao icone="code" selo="Desenvolvimento de Sistemas" titulo="Matérias" cor="var(--color-ds)">
        Escolha uma matéria: cada uma reúne os bimestres e as aulas do curso, na ordem. Cada aula junta tudo o que foi visto na semana e termina com as perguntas do “Pause e Responda”. As aulas ainda não escritas aparecem como “Em breve”.
      </TopoSecao>
      <AreaMaterias area={grupo} porMateria={porMateria} emBreve={emBreve} base="/ds" cabeca={false} />
    </Fragment>
  )}
</Base>
