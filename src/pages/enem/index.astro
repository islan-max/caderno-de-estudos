---
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { u } from '../../lib/url';
import { ENEM_AREAS } from '../../lib/enemAreas';
import { indiceEnem } from '../../lib/aulas';

// Toda matéria das 4 áreas aparece na página, mesmo sem conteúdo publicado
// ainda (estado vazio padronizado).
const aulas = await indiceEnem();

const porMateria = new Map<string, string[]>();
for (const a of aulas) {
  porMateria.set(a.materia, [...(porMateria.get(a.materia) ?? []), a.id]);
}
---

<Base
  title="ENEM"
  active="enem"
  description="Matérias do ENEM organizadas pelas 4 áreas do conhecimento"
  voltar={{ href: u('/'), label: 'Início' }}
>
  <header class="topo" data-surgir>
    <p class="topo__kicker"><Icone nome="graduation-cap" /> Enem</p>
    <h1 class="topo__h1">Matérias por área</h1>
    <p class="topo__texto">
      Conteúdo direto ao ponto, pensado para o que o INEP realmente cobra. Cada matéria abre uma
      trilha de aulas na ordem de aprendizado — sem bimestre, sem semana, só o tema e o treino.
    </p>
  </header>

  <div class="areas">
    {ENEM_AREAS.map((area, ai) => {
      const idsDaArea = area.subjects.flatMap((s) => porMateria.get(s.slug) ?? []);
      return (
        <section class="area" style={`--cor: ${area.cor}; --i: ${ai}`} data-surgir>
          <header class="area__cabeca">
            <h2 class="area__titulo">
              <Icone nome={area.icone} duo cor={area.cor} class="area__icone" />
              {area.label}
            </h2>
            {idsDaArea.length > 0 && (
              <span class="area__contador" data-progresso-de={idsDaArea.join(' ')}
                ><span data-progresso-texto>0 de {idsDaArea.length}</span> vistas</span
              >
            )}
          </header>

          <ul class="area__lista">
            {area.subjects.map((s) => {
              const ids = porMateria.get(s.slug) ?? [];
              const count = ids.length;
              return (
                <li>
                  {count > 0 ? (
                    <a href={u(`/enem/${s.slug}/`)} class="materia" data-progresso-de={ids.join(' ')}>
                      <Icone nome={s.icone} duo cor={area.cor} class="materia__icone" />
                      <span class="materia__corpo">
                        <span class="materia__nome">{s.label}</span>
                        <span class="materia__meta">
                          <span>{count} {count === 1 ? 'aula' : 'aulas'}</span>
                          <span aria-hidden="true">·</span>
                          <span><span data-progresso-texto>0 de {count}</span> vistas</span>
                        </span>
                        <span class="materia__trilho">
                          <span data-progresso-barra></span>
                        </span>
                      </span>
                      <Icone nome="arrow-right" class="materia__seta" />
                    </a>
                  ) : (
                    <div class="materia materia--vazia">
                      <Icone nome="hourglass-half" class="materia__icone" />
                      <span class="materia__corpo">
                        <span class="materia__nome">{s.label}</span>
                        <span class="materia__meta">Material ainda não compartilhado</span>
                      </span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</Base>

<style>
  .topo {
    margin-bottom: 2.5rem;
  }
  .topo__kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-enem);
    margin: 0 0 0.6rem;
  }
  .topo__h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.2rem + 2.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0 0 0.85rem;
  }
  .topo__texto {
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 40rem;
    margin: 0;
  }

  .areas {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .area__cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1rem;
    border-bottom: 2px solid color-mix(in srgb, var(--cor) 35%, var(--color-line));
  }
  .area__titulo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .area__icone {
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .area__contador {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .area__contador[data-completo='true'] {
    color: var(--color-ok);
  }

  .area__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) {
    .area__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .materia {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--cor) 5%, transparent);
    text-decoration: none;
    color: var(--color-ink);
  }
  a.materia:hover {
    border-color: var(--cor);
    background: color-mix(in srgb, var(--cor) 11%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }
  .materia--vazia {
    opacity: 0.55;
    border-style: dashed;
    background: transparent;
  }
  .materia__icone {
    font-size: 0.9rem;
    flex-shrink: 0;
    color: var(--color-ink-soft);
  }
  .materia__corpo {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    min-width: 0;
    flex: 1;
  }
  .materia__nome {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.25;
  }
  .materia__meta {
    font-family: var(--font-display);
    font-size: 0.68rem;
    color: var(--color-ink-soft);
    display: flex;
    gap: 0.28rem;
  }
  .materia__trilho {
    display: block;
    height: 4px;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    overflow: hidden;
  }
  .materia__trilho span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: var(--cor);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.75s var(--ease);
  }
  .materia[data-completo='true'] .materia__trilho span {
    background: var(--color-ok);
  }
  .materia__seta {
    flex-shrink: 0;
    font-size: 0.72rem;
    color: var(--cor);
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity 0.22s var(--ease), transform 0.22s var(--ease);
  }
  a.materia:hover .materia__seta {
    opacity: 1;
    transform: none;
  }
</style>
