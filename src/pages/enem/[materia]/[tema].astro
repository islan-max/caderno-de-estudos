---
import Tema from '../../../layouts/Tema.astro';
import { getCollection, render } from 'astro:content';
import { u } from '../../../lib/url';
import { vizinhas } from '../../../lib/aulas';

export async function getStaticPaths() {
  const aulas = await getCollection('enem');
  return aulas.map((aula) => {
    const [materia, tema] = aula.id.split('/');
    return { params: { materia, tema } };
  });
}

const { materia, tema } = Astro.params;
const entries = await getCollection('enem');
const entry = entries.find((aula) => aula.id === `${materia}/${tema}`);
if (!entry) return Astro.redirect(u('/enem'));
const Content = (await render(entry)).Content;
const subjectLabel = entry.data.subject;
const posicao = await vizinhas(materia!, tema!);
---

<Tema
  title={entry.data.title}
  subject={subjectLabel}
  relevance={entry.data.relevance}
  quickSummary={entry.data.quickSummary}
  resources={entry.data.resources}
  active="enem"
  aulaId={`enem/${materia}/${tema}`}
  vizinhas={posicao}
  materiaHref={u(`/enem/${materia}/`)}
  breadcrumb={[
    { label: 'ENEM', href: u('/enem') },
    { label: subjectLabel, href: u(`/enem/${materia}/`) },
    { label: entry.data.title },
  ]}
>
  {Content && <Content />}
</Tema>
