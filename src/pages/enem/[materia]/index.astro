---
import Base from '../../../layouts/Base.astro';
import TrilhaAulas from '../../../components/TrilhaAulas.astro';
import TopoMateria from '../../../components/TopoMateria.astro';
import { getCollection } from 'astro:content';
import { splitSlug } from '../../../lib/slug';
import { u } from '../../../lib/url';
import { trilhaEnem } from '../../../lib/aulas';
import { areaDaMateria, iconeDaMateria } from '../../../lib/enemAreas';

export async function getStaticPaths() {
  const aulas = await getCollection('enem');
  return [...new Set(aulas.map((aula) => splitSlug(aula.id)[0]))].map((materia) => ({ params: { materia } }));
}

const { materia } = Astro.params;
// Todas as aulas do mapa, já na ordem de aprendizado; as que ainda não existem vêm sem link.
const trilha = await trilhaEnem(materia!);
const prontas = trilha.filter((t) => t.pronta);
if (prontas.length === 0) return Astro.redirect(u('/enem'));

// O nome da matéria vem do frontmatter de uma aula pronta.
const subjectLabel = (await getCollection('enem')).find((a) => a.id.startsWith(`${materia}/`))!.data.subject;
const area = areaDaMateria(materia!);
---

<Base
  title={subjectLabel}
  active="enem"
  description={`Temas de ${subjectLabel} para o ENEM, na ordem de aprendizado`}
  voltar={{ href: u('/enem'), label: 'Matérias do ENEM' }}
  cor={`var(--color-${materia})`}
>
  <nav class="font-mono text-xs text-ink-soft mb-4" aria-label="Você está aqui">
    <a href={u('/enem')} class="hover:text-ink underline underline-offset-2">ENEM</a>
    <span> / </span>
    <span class="text-ink">{subjectLabel}</span>
  </nav>

  <TopoMateria
    nome={subjectLabel}
    icone={iconeDaMateria(materia!)}
    area={area?.label}
    cor={`var(--color-${materia})`}
    ids={prontas.map((t) => t.id)}
    dica="As aulas estão na ordem de aprendizado: comece pela primeira e desça a lista. As marcadas “Em breve” ainda não foram escritas."
  />

  <TrilhaAulas aulas={trilha} accent={materia} />
</Base>
