---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { u } from '../lib/url';
import { ENEM_AREAS } from '../lib/enemAreas';
import { indiceEnem } from '../lib/aulas';
import { SECOES_VISIVEIS } from '../lib/secoes';

const aulas = await indiceEnem();
const total = aulas.length;
const todosIds = aulas.map((a) => a.id).join(' ');

const porArea = ENEM_AREAS.map((area) => {
  const ids = aulas.filter((a) => a.areaCurto === area.labelCurto).map((a) => a.id);
  return { ...area, ids, total: ids.length };
}).filter((a) => a.total > 0);

const materiasComAula = new Set(aulas.map((a) => a.materia)).size;
---

<Base title="Início" active="hub" description="Seu painel de estudos: progresso, busca e trilhas por área">
  <div data-hub>
    <!-- ------------------------------------------------------------- hero -->
    <section class="hero" data-surgir>
      <p class="hero__kicker"><Icone nome="compass" /> Painel de estudos</p>
      <h1 class="hero__h1">Todas as suas aulas, num lugar só.</h1>
      <p class="hero__texto">
        {total} aulas em {materiasComAula} matérias, organizadas na ordem de aprendizado. O caderno
        lembra o que você já viu, direto no seu navegador, sem conta e sem cadastro.
      </p>

      <button type="button" class="busca-grande" data-acao="busca">
        <Icone nome="magnifying-glass" class="busca-grande__lupa" />
        <span class="busca-grande__texto">Buscar uma aula, matéria ou área…</span>
        <kbd class="busca-grande__atalho">Ctrl K</kbd>
      </button>
    </section>

    <!-- ---------------------------------------------------- continuar -->
    <section class="continuar" data-continuar hidden data-surgir style="--i: 1">
      <span class="continuar__selo"><Icone nome="play" /> Continuar de onde parou</span>
      <a class="continuar__link" data-continuar-link href={u('/enem')}>
        <span class="continuar__corpo">
          <span class="continuar__titulo" data-continuar-titulo></span>
          <span class="continuar__meta" data-continuar-meta></span>
        </span>
        <span class="continuar__seta"><Icone nome="arrow-right" /></span>
      </a>
    </section>

    <!-- ------------------------------------------------------ progresso -->
    <section class="painel-progresso" data-progresso-de={todosIds} data-surgir style="--i: 2">
      <div class="painel-progresso__esq">
        <span class="painel-progresso__rotulo"><Icone nome="chart-simple" /> Progresso geral</span>
        <p class="painel-progresso__numero">
          <span data-progresso-texto>0 de {total}</span>
          <span class="painel-progresso__unidade">aulas vistas</span>
        </p>
        <div class="painel-progresso__trilho" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Progresso geral">
          <span data-progresso-barra></span>
        </div>
      </div>
      <div class="painel-progresso__acoes">
        <!-- "Ver detalhes" e a troca de tema saíram: as duas já vivem na barra
             de ferramentas do topo, presente em todas as páginas. -->
        <button type="button" class="acao-rapida" data-acao="sortear">
          <Icone nome="dice" /> Sortear aula
        </button>
      </div>
    </section>

    <!-- ----------------------------------------------------------- áreas -->
    <section class="secao" data-surgir style="--i: 3">
      <header class="secao__cabeca">
        <h2 class="secao__titulo"><Icone nome="layer-group" duo cor="var(--color-ink)" /> Trilhas por área</h2>
        <a href={u('/enem')} class="secao__link">Ver todas as matérias <Icone nome="arrow-right" /></a>
      </header>

      <ul class="areas">
        {porArea.map((area) => (
          <li>
            <a href={u('/enem')} class="area-card" style={`--cor: ${area.cor}`} data-progresso-de={area.ids.join(' ')}>
              <Icone nome={area.icone} duo cor={area.cor} class="area-card__icone" />
              <span class="area-card__nome">{area.labelCurto}</span>
              <span class="area-card__meta">
                <span>{area.total} {area.total === 1 ? 'aula' : 'aulas'}</span>
                <span aria-hidden="true">·</span>
                <span data-progresso-texto>0 de {area.total}</span>
              </span>
              <span class="area-card__trilho" aria-hidden="true"><span data-progresso-barra></span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- --------------------------------------------------------- recentes -->
    <section class="secao" data-recentes hidden data-surgir style="--i: 4">
      <header class="secao__cabeca">
        <h2 class="secao__titulo"><Icone nome="clock" duo cor="var(--color-ink)" /> Vistas recentemente</h2>
        <button type="button" class="secao__link secao__link--botao" data-abre="progresso">
          Meu progresso <Icone nome="arrow-right" />
        </button>
      </header>
      <ul class="recentes" data-recentes-lista></ul>
    </section>

    <!-- ------------------------------------------------------------ ajuda -->
    <details class="secao ajuda" data-dobra="ajuda" data-surgir style="--i: 5" open>
      <summary class="ajuda__resumo">
        <h2 class="secao__titulo">
          <Icone nome="lightbulb" duo cor="var(--color-ink)" /> Como este caderno funciona
        </h2>
        <span class="ajuda__seta"><Icone nome="chevron-down" /></span>
      </summary>
      <ul class="dicas">
        <li class="dica">
          <Icone nome="signs-post" duo cor="var(--color-escolar)" class="dica__icone" />
          <p><strong>Ordem de aprendizado.</strong> Dentro de cada matéria as aulas descem na sequência certa. Comece pela primeira e siga a trilha.</p>
        </li>
        <li class="dica">
          <Icone nome="circle-check" duo cor="var(--color-ok)" class="dica__icone" />
          <p><strong>Marcação automática.</strong> Ao terminar de ler, a aula é marcada como vista. Dá para marcar e desmarcar na mão também.</p>
        </li>
        <li class="dica">
          <Icone nome="keyboard" duo cor="var(--color-enem)" class="dica__icone" />
          <p><strong>Atalhos.</strong> <kbd>Ctrl</kbd>+<kbd>K</kbd> abre a busca; as setas <kbd>←</kbd> <kbd>→</kbd> trocam de aula dentro da matéria.</p>
        </li>
        <li class="dica">
          <Icone nome="database" duo cor="var(--color-ink-soft)" class="dica__icone" />
          <p><strong>Só no seu aparelho.</strong> O progresso fica no armazenamento local do navegador. Nada é enviado para servidor nenhum.</p>
        </li>
      </ul>
    </details>

    {SECOES_VISIVEIS.length < 2 && (
      <aside class="aviso-secoes" data-surgir style="--i: 6">
        <span class="aviso-secoes__icone"><Icone nome="hourglass-half" /></span>
        <span class="aviso-secoes__texto">
          <strong class="aviso-secoes__titulo">Duas trilhas estão em revisão</strong>
          <span class="aviso-secoes__corpo">
            <b>Escolar</b> e <b>Desenvolvimento de Sistemas</b> saíram do ar temporariamente
            enquanto o material é reorganizado. Nada foi apagado: elas voltam assim que a revisão
            terminar.
          </span>
        </span>
      </aside>
    )}
  </div>
</Base>

<style>
  /* ------------------------------------------------------------------ hero */
  .hero {
    margin-bottom: 2rem;
  }
  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    margin: 0 0 0.7rem;
  }
  .hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.1rem + 3.6vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.06;
    margin: 0 0 0.9rem;
    max-width: 15ch;
  }
  .hero__texto {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 38rem;
    margin: 0 0 1.5rem;
  }

  .busca-grande {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 1.05rem 0.9rem 1.05rem 1.15rem;
    border: 1px solid var(--color-line);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--color-paper-dark) 30%, transparent);
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 0.98rem;
    cursor: pointer;
    text-align: left;
  }
  .busca-grande:hover {
    border-color: color-mix(in srgb, var(--color-ink) 32%, var(--color-line));
    background: var(--color-paper-dark);
    color: var(--color-ink);
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }
  .busca-grande__texto {
    flex: 1;
  }
  .busca-grande__lupa {
    font-size: 0.95rem;
  }
  .busca-grande__atalho {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.24rem 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-surface);
  }
  @media (max-width: 480px) {
    .busca-grande__atalho {
      display: none;
    }
  }

  /* ------------------------------------------------------------ continuar */
  .continuar {
    position: relative;
    margin-bottom: 1.25rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-enem) 35%, var(--color-line));
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--color-enem) 7%, transparent);
  }
  .continuar__selo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.64rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-enem);
    margin-bottom: 0.6rem;
  }
  .continuar__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .continuar__corpo {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
  }
  .continuar__titulo {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .continuar__meta {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-ink-soft);
  }
  .continuar__seta {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--color-enem);
    color: var(--color-paper);
    font-size: 0.8rem;
    transition: transform 0.24s var(--ease);
  }
  .continuar__link:hover .continuar__seta {
    transform: translateX(4px);
  }

  /* ------------------------------------------------------------ progresso */
  .painel-progresso {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--color-line);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--color-paper-dark) 26%, transparent);
  }
  .painel-progresso[data-completo='true'] {
    border-color: color-mix(in srgb, var(--color-ok) 45%, transparent);
  }
  .painel-progresso__esq {
    flex: 1 1 15rem;
    min-width: 0;
  }
  .painel-progresso__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
  }
  .painel-progresso__numero {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0.35rem 0 0.6rem;
  }
  .painel-progresso__unidade {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .painel-progresso__trilho {
    height: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    overflow: hidden;
  }
  .painel-progresso__trilho span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-enem), var(--color-ok));
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.8s var(--ease);
  }
  .painel-progresso__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .acao-rapida {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
  }
  .acao-rapida:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 32%, var(--color-line));
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }

  /* --------------------------------------------------------------- seções */
  .secao {
    margin-bottom: 2.5rem;
  }
  .secao__cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .secao__titulo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .secao__titulo--solo {
    margin-bottom: 1rem;
  }
  .secao__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .secao__link--botao {
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
  }
  .secao__link:hover {
    color: var(--color-ink);
  }

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 760px) {
    .areas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .area-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--cor) 6%, transparent);
    text-decoration: none;
    color: var(--color-ink);
  }
  .area-card:hover {
    border-color: var(--cor);
    background: color-mix(in srgb, var(--cor) 13%, transparent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }
  .area-card__icone {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }
  .area-card__nome {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .area-card__meta {
    display: flex;
    gap: 0.28rem;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-size: 0.68rem;
    color: var(--color-ink-soft);
  }
  .area-card__trilho {
    display: block;
    height: 4px;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    overflow: hidden;
  }
  .area-card__trilho span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: var(--cor);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.8s var(--ease);
  }

  /* ------------------------------------------------------------- recentes */
  .recentes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* ---------------------------------------------------------------- dicas */
  .dicas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .dicas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .dica {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--color-line);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--color-paper-dark) 20%, transparent);
  }
  .dica__icone {
    flex-shrink: 0;
    font-size: 0.85rem;
    margin-top: 0.05rem;
  }
  .dica p {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .dica strong {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
  .dica kbd {
    display: inline-block;
    padding: 0.02rem 0.28rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    font-family: var(--font-display);
    font-size: 0.72em;
  }

  /* ------------------------------------------------------- seção retrátil */
  .ajuda {
    /* Sem isto o Safari desenha um triângulo próprio ao lado do summary. */
    --nada: 0;
  }
  .ajuda__resumo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.35rem 0.5rem 0.35rem 0;
    border-radius: 0.5rem;
    cursor: pointer;
    list-style: none;
  }
  .ajuda__resumo::-webkit-details-marker {
    display: none;
  }
  .ajuda__resumo:hover {
    background: color-mix(in srgb, var(--color-paper-dark) 25%, transparent);
  }
  .ajuda__seta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: 0.7rem;
    transition: transform 0.25s var(--ease), color 0.2s var(--ease);
  }
  .ajuda[open] .ajuda__seta {
    transform: rotate(180deg);
  }
  .ajuda__resumo:hover .ajuda__seta {
    color: var(--color-ink);
  }

  /* ---------------------------------------------------------------- aviso */
  .aviso-secoes {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-escolar) 40%, var(--color-line));
    border-left-width: 4px;
    border-left-color: var(--color-escolar);
    border-radius: 0.2rem 0.75rem 0.75rem 0.2rem;
    background: var(--color-escolar-soft);
    margin: 0;
  }
  .aviso-secoes__icone {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-escolar) 18%, transparent);
    color: var(--color-escolar);
    font-size: 0.85rem;
  }
  .aviso-secoes__texto {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .aviso-secoes__titulo {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .aviso-secoes__corpo {
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .aviso-secoes__corpo b {
    color: var(--color-ink);
    font-weight: 800;
  }
</style>
