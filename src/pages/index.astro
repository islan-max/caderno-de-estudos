---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Accordion from '../components/Accordion.astro';
import { u } from '../lib/url';
import { ENEM_AREAS } from '../lib/enemAreas';
import { indiceEnem } from '../lib/aulas';
import { SECOES_VISIVEIS } from '../lib/secoes';

const aulas = await indiceEnem();
const total = aulas.length;
const todosIds = aulas.map((a) => a.id).join(' ');

const porArea = ENEM_AREAS.map((area) => {
  const ids = aulas.filter((a) => a.areaCurto === area.labelCurto).map((a) => a.id);
  return { ...area, ids, total: ids.length };
}).filter((a) => a.total > 0);

const materiasComAula = new Set(aulas.map((a) => a.materia)).size;
---

<Base title="Início" active="hub" description="Seu painel de estudos: progresso, busca e trilhas por área">
  <div data-hub>
    <!-- ------------------------------------------------------------- hero -->
    <section class="hero" data-surgir>
      <div class="hero__topo">
        <p class="hero__kicker"><Icone nome="compass" /> Painel de estudos</p>
        <p class="hero__numeros">
          <strong>{total}</strong> aulas <span aria-hidden="true">·</span> <strong>{materiasComAula}</strong> matérias
        </p>
      </div>
      <span class="hero__mao" aria-hidden="true">bem-vindo de volta!</span>
      <h1 class="hero__h1">
        Todas as suas aulas,{' '}
        <span class="hero__traco"
          >num lugar só.<svg viewBox="0 0 200 10" preserveAspectRatio="none" aria-hidden="true"
            ><path d="M2 6 C40 1 70 9 110 4 S170 3 198 6" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" /></svg
        ></span>
      </h1>
      <p class="hero__texto">
        Organizadas na ordem de aprendizado. O caderno lembra o que você já viu, direto no seu
        navegador, sem conta e sem cadastro.
      </p>

      <button type="button" class="busca-grande" data-acao="busca">
        <Icone nome="magnifying-glass" class="busca-grande__lupa" />
        <span class="busca-grande__texto">Buscar uma aula, matéria ou área…</span>
      </button>
    </section>

    <!-- ---------------------------------------------------- continuar -->
    <!-- O título é a aula em que a pessoa parou; a linha de baixo, menor, diz qual aula vem a
         seguir (preenchido em montarHub, app.ts). A seta leva para onde continuar. -->
    <section class="continuar" data-continuar hidden data-surgir style="--i: 1">
      <span class="continuar__selo"><Icone nome="play" /> Continuar de onde parou</span>
      <div class="continuar__linha">
        <div class="continuar__corpo">
          <a class="continuar__titulo" data-continuar-parou href={u('/enem')}></a>
          <p class="continuar__proxima">
            <span class="continuar__rotulo" data-continuar-rotulo></span>
            <a class="continuar__proxima-link" data-continuar-proxima href={u('/enem')} hidden></a>
          </p>
        </div>
        <a class="continuar__seta" data-continuar-seta href={u('/enem')} aria-label="Continuar de onde parou">
          <Icone nome="arrow-right" />
        </a>
      </div>
    </section>

    <!-- ------------------------------------------------------ progresso -->
    <section class="painel-progresso" data-progresso-de={todosIds} data-surgir style="--i: 2">
      <div class="painel-progresso__esq">
        <span class="painel-progresso__rotulo"><Icone nome="chart-simple" /> Progresso geral</span>
        <p class="painel-progresso__numero">
          <span data-progresso-texto>0 de {total}</span>
          <span class="painel-progresso__unidade">aulas vistas</span>
        </p>
        <div class="painel-progresso__trilho" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Progresso geral">
          <span data-progresso-barra></span>
        </div>
      </div>
      <div class="painel-progresso__acoes">
        <!-- "Ver detalhes" e a troca de tema saíram: as duas já vivem na barra
             de ferramentas do topo, presente em todas as páginas. -->
        <button type="button" class="acao-rapida" data-acao="sortear">
          <Icone nome="dice" /> Sortear aula
        </button>
      </div>
    </section>

    <!-- ----------------------------------------------------------- áreas -->
    <section class="secao" data-surgir style="--i: 3">
      <header class="secao__cabeca">
        <h2 class="secao__titulo"><Icone nome="layer-group" duo cor="var(--color-ink)" /> Trilhas por área</h2>
        <a href={u('/enem')} class="secao__link">Ver todas as matérias <Icone nome="arrow-right" /></a>
      </header>

      <ul class="areas">
        {porArea.map((area) => (
          <li>
            <a href={u(`/enem/areas/${area.slug}/`)} class="area-card" style={`--cor: ${area.cor}`} data-progresso-de={area.ids.join(' ')}>
              <Icone nome={area.icone} duo cor={area.cor} class="area-card__icone" />
              <span class="area-card__nome">{area.labelCurto}</span>
              <span class="area-card__meta">
                <span>{area.total} {area.total === 1 ? 'aula' : 'aulas'}</span>
                <span aria-hidden="true">·</span>
                <span data-progresso-texto>0 de {area.total}</span>
              </span>
              <span class="area-card__trilho" aria-hidden="true"><span data-progresso-barra></span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- --------------------------------------------------------- recentes -->
    <!-- Mesmo cartão do Raio-X das aulas: uma seção à parte, que abre e fecha. A lista é montada
         em JS (montarHub) com todas as aulas já vistas e rola dentro do cartão. -->
    <div class="bloco bloco--recentes" data-recentes hidden data-surgir style="--i: 4">
      <Accordion
        titulo="Vistas recentemente"
        dica="Aulas que você já viu, da mais recente para a mais antiga"
        icone="clock"
        dobra="recentes"
        aberto
      >
        <ul class="recentes" data-recentes-lista></ul>
        <button slot="rodape" type="button" class="recentes__progresso" data-abre="progresso">
          Abrir meu progresso completo <Icone nome="arrow-right" />
        </button>
      </Accordion>
    </div>

    <!-- ------------------------------------------------------------ ajuda -->
    <section class="acordeao bloco bloco--ajuda" data-dispensavel="ajuda" data-surgir style="--i: 5">
      <div class="bloco__cabeca">
        <span class="acordeao__icone"><Icone nome="lightbulb" duo cor="var(--acordeao-tinta)" /></span>
        <span class="acordeao__textos">
          <h2 class="acordeao__titulo">Como este caderno funciona</h2>
          <span class="acordeao__dica">Quatro coisas para começar. Ao fechar, ela não aparece mais.</span>
        </span>
        <button type="button" class="dispensar" data-dispensar aria-label="Dispensar: não mostrar mais esta seção" title="Já li, não mostrar mais">
          <Icone nome="xmark" />
        </button>
      </div>
      <ul class="dicas">
        <li class="dica">
          <Icone nome="signs-post" duo cor="var(--color-escolar)" class="dica__icone" />
          <p><strong>Ordem de aprendizado.</strong> Dentro de cada matéria as aulas descem na sequência certa. Comece pela primeira e siga a trilha.</p>
        </li>
        <li class="dica">
          <Icone nome="circle-check" duo cor="var(--color-ok)" class="dica__icone" />
          <p><strong>Andamento da aula.</strong> O anel ao lado de cada aula enche conforme você lê e responde as questões. Quando tudo está feito, ela é concluída. Dá para marcar e desmarcar na mão também.</p>
        </li>
        <li class="dica">
          <Icone nome="keyboard" duo cor="var(--color-enem)" class="dica__icone" />
          <p><strong>Atalhos.</strong> <kbd>Ctrl</kbd>+<kbd>K</kbd> abre a busca; as setas <kbd>←</kbd> <kbd>→</kbd> trocam de aula dentro da matéria.</p>
        </li>
        <li class="dica">
          <Icone nome="database" duo cor="var(--color-ink-soft)" class="dica__icone" />
          <p><strong>Só no seu aparelho.</strong> O progresso fica no armazenamento local do navegador. Nada é enviado para servidor nenhum.</p>
        </li>
      </ul>
    </section>

    {SECOES_VISIVEIS.length < 2 && (
      <aside class="aviso-secoes" data-surgir style="--i: 6">
        <span class="aviso-secoes__icone"><Icone nome="hourglass-half" /></span>
        <span class="aviso-secoes__texto">
          <strong class="aviso-secoes__titulo">Duas trilhas estão em revisão</strong>
          <span class="aviso-secoes__corpo">
            <b>Escolar</b> e <b>Desenvolvimento de Sistemas</b> saíram do ar temporariamente
            enquanto o material é reorganizado. Nada foi apagado: elas voltam assim que a revisão
            terminar.
          </span>
        </span>
      </aside>
    )}
  </div>
</Base>

<style>
  /* ------------------------------------------------------------------ hero */
  /* Uma coluna só, sem caixas: o rótulo e o tamanho do caderno dividem a primeira linha, o
     título cabe numa linha (e quebra de forma equilibrada em tela estreita) e a busca vem logo
     abaixo. Nada de marca-texto nem de cartões de número: o espaço é usado, mas sem poluir. */
  .hero {
    margin-bottom: 2rem;
  }
  .hero__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.7rem;
  }
  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: calc(0.68rem * var(--escala-texto, 1));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .hero__numeros {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(0.78rem * var(--escala-texto, 1));
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .hero__numeros strong {
    font-weight: 800;
    color: var(--color-ink);
  }
  /* Recado manuscrito acima do título e traço feito à mão embaixo da segunda metade. */
  .hero__mao {
    display: inline-block;
    font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive;
    font-size: calc(1.7rem * var(--escala-texto, 1));
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-enem);
    transform: rotate(-1.5deg);
    transform-origin: left bottom;
    margin-bottom: 0.1rem;
  }
  .hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 2.6vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }
  .hero__traco {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .hero__traco svg {
    position: absolute;
    left: -2%;
    bottom: -0.28em;
    width: 104%;
    height: 0.5em;
    overflow: visible;
    color: var(--color-enem);
  }
  .hero__texto {
    font-family: var(--font-body);
    font-size: calc(1rem * var(--escala-texto, 1));
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 38rem;
    margin: 0 0 1.3rem;
  }

  .busca-grande {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 1.05rem 0.9rem 1.05rem 1.15rem;
    border: 1px solid var(--color-line);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--color-paper-dark) 30%, transparent);
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: calc(0.98rem * var(--escala-texto, 1));
    cursor: pointer;
    text-align: left;
  }
  .busca-grande:hover {
    border-color: color-mix(in srgb, var(--color-ink) 32%, var(--color-line));
    background: var(--color-paper-dark);
    color: var(--color-ink);
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }
  .busca-grande__texto {
    flex: 1;
  }
  .busca-grande__lupa {
    font-size: calc(0.95rem * var(--escala-texto, 1));
  }

  /* ------------------------------------------------------------ continuar */
  .continuar {
    position: relative;
    margin-bottom: 1.25rem;
    padding: 1rem 1rem 1.05rem;
    border: 1px solid color-mix(in srgb, var(--cor-continuar, var(--color-enem)) 35%, var(--color-line));
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--cor-continuar, var(--color-enem)) 7%, transparent);
  }
  .continuar__selo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: calc(0.64rem * var(--escala-texto, 1));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--cor-continuar, var(--color-enem));
    margin-bottom: 0.55rem;
  }
  .continuar__linha {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .continuar__corpo {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }
  /* O título é a aula em que a pessoa parou. */
  .continuar__titulo {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: calc(1.5rem * var(--escala-texto, 1));
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
    text-decoration: none;
  }
  .continuar__titulo:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  /* Embaixo, menor: a aula recomendada, sublinhada na cor do cartão. */
  .continuar__proxima {
    margin: 0;
    font-family: var(--font-body);
    font-size: calc(0.86rem * var(--escala-texto, 1));
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .continuar__rotulo {
    margin-right: 0.35em;
  }
  .continuar__rotulo:empty {
    display: none;
  }
  .continuar__proxima-link {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--cor-continuar, var(--color-enem)) 70%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .continuar__proxima-link:hover {
    text-decoration-color: var(--cor-continuar, var(--color-enem));
  }
  .continuar__seta {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--cor-continuar, var(--color-enem));
    color: var(--color-paper);
    font-size: calc(0.8rem * var(--escala-texto, 1));
    text-decoration: none;
    transition: transform 0.24s var(--ease);
  }
  .continuar__seta:hover {
    transform: translateX(4px);
  }

  /* ------------------------------------------------------------ progresso */
  .painel-progresso {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--color-line);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--color-paper-dark) 26%, transparent);
  }
  .painel-progresso[data-completo='true'] {
    border-color: color-mix(in srgb, var(--color-ok) 45%, transparent);
  }
  .painel-progresso__esq {
    flex: 1 1 15rem;
    min-width: 0;
  }
  .painel-progresso__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: calc(0.66rem * var(--escala-texto, 1));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
  }
  .painel-progresso__numero {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: calc(1.15rem * var(--escala-texto, 1));
    font-weight: 700;
    margin: 0.35rem 0 0.6rem;
  }
  .painel-progresso__unidade {
    font-size: calc(0.78rem * var(--escala-texto, 1));
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .painel-progresso__trilho {
    height: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    overflow: hidden;
  }
  .painel-progresso__trilho span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    /* A cor da borda da aba Início: tinta clara no escuro, tinta escura no claro. Sem degradê. */
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.8s var(--ease);
  }
  .painel-progresso__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .acao-rapida {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: calc(0.76rem * var(--escala-texto, 1));
    font-weight: 600;
    cursor: pointer;
  }
  .acao-rapida:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-ink) 32%, var(--color-line));
    transform: translateY(-1px);
    box-shadow: var(--shadow-soft);
  }

  /* --------------------------------------------------------------- seções */
  .secao {
    margin-bottom: 2.5rem;
  }
  .secao__cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .secao__titulo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: calc(1rem * var(--escala-texto, 1));
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .secao__titulo--solo {
    margin-bottom: 1rem;
  }
  .secao__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: calc(0.75rem * var(--escala-texto, 1));
    font-weight: 600;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .secao__link--botao {
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
  }
  .secao__link:hover {
    color: var(--color-ink);
  }

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 760px) {
    .areas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .area-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--cor) 6%, transparent);
    text-decoration: none;
    color: var(--color-ink);
  }
  .area-card:hover {
    border-color: var(--cor);
    background: color-mix(in srgb, var(--cor) 13%, transparent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }
  .area-card__icone {
    font-size: calc(1rem * var(--escala-texto, 1));
    margin-bottom: 0.35rem;
  }
  .area-card__nome {
    font-family: var(--font-display);
    font-size: calc(0.95rem * var(--escala-texto, 1));
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .area-card__meta {
    display: flex;
    gap: 0.28rem;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-size: calc(0.68rem * var(--escala-texto, 1));
    color: var(--color-ink-soft);
  }
  .area-card__trilho {
    display: block;
    height: 4px;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 10%, transparent);
    overflow: hidden;
  }
  .area-card__trilho span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: var(--cor);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.8s var(--ease);
  }

  /* --------------------------------------------- blocos de destaque (cartões) */
  /* "Vistas recentemente" e "Como este caderno funciona" são cartões à parte, no mesmo
     desenho do Raio-X das aulas (global, em Accordion.astro): fundo tingido, ícone, título
     em caixa alta e dica. A cor vem de --acordeao-cor. */
  .bloco {
    margin: 0 0 2.5rem;
  }
  .bloco--recentes {
    --acordeao-cor: var(--color-escolar);
  }
  .bloco--recentes :global(.acordeao) {
    margin: 0;
  }
  /* A lista rola dentro do cartão (a barra e a área rolável são as do próprio Accordion). */
  .bloco--recentes :global(.acordeao__area) {
    max-height: 20rem;
  }
  .recentes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .recentes__progresso {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--acordeao-tinta) 35%, var(--color-line));
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--acordeao-tinta);
    font-family: var(--font-display);
    font-size: calc(0.76rem * var(--escala-texto, 1));
    font-weight: 700;
    cursor: pointer;
