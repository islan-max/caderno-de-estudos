---
// Os bimestres agora ficam na página da matéria. Esta rota só existe para links antigos: mostra
// um aviso com o link e leva sozinha até o bimestre certo.
import { secaoVisivel } from '../../../../lib/secoes';
import Base from '../../../../layouts/Base.astro';
import { u } from '../../../../lib/url';
import { materiasEscolar } from '../../../../lib/escolar';

export async function getStaticPaths() {
  // Seção oculta (src/lib/secoes.ts): nenhuma rota é gerada.
  if (!secaoVisivel('escolar')) return [];
  return (await materiasEscolar()).flatMap((m) =>
    m.bimestres.map((b) => ({ params: { materia: m.slug, bimestre: b.slug }, props: { nome: m.nome, label: b.label } }))
  );
}

const { materia, bimestre } = Astro.params;
const { nome, label } = Astro.props;
const destino = u(`/escolar/${materia}/#${bimestre}`);
---

<Base title={`${nome} · ${label}`} active="escolar" description={`Aulas de ${nome}, ${label}`}>
  <h1 class="font-display text-3xl font-bold text-ink mb-3">{nome} · {label}</h1>
  <p class="font-body text-ink-soft">
    Os bimestres agora ficam na página da matéria.
    <a href={destino} class="underline underline-offset-2">Abrir {label} de {nome}</a>.
  </p>
  <script is:inline define:vars={{ destino }}>
    location.replace(destino);
  </script>
</Base>
