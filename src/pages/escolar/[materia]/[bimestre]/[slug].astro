---
import { secaoVisivel } from '../../../../lib/secoes';
import Tema from '../../../../layouts/Tema.astro';
import Accordion from '../../../../components/Accordion.astro';
import { getCollection, render } from 'astro:content';
import { bimestreLabel as bimLabelFn } from '../../../../lib/slug';
import { u } from '../../../../lib/url';

export async function getStaticPaths() {
  // Seção oculta (src/lib/secoes.ts): nenhuma rota é gerada.
  if (!secaoVisivel('escolar')) return [];
  const aulas = await getCollection('escolar');
  return aulas.map((aula) => {
    const [materia, bimestre, slugAula] = aula.id.split('/');
    return { params: { materia, bimestre, slug: slugAula } };
  });
}

const { materia, bimestre, slug } = Astro.params;
const entries = await getCollection('escolar');
const entry = entries.find((e) => e.id === `${materia}/${bimestre}/${slug}`);
if (!entry) return Astro.redirect(u('/escolar'));
const Content = (await render(entry)).Content;
const subjectLabel = entry.data.subject;
---

<Tema
  title={entry.data.title}
  subject={subjectLabel}
  relevance={entry.data.relevance}
  quickSummary={entry.data.quickSummary}
  resources={entry.data.resources}
  ferramentas={entry.data.ferramentas}
  active="escolar"
  materia={materia}
  aulaId={`escolar/${materia}/${bimestre}/${slug}`}
  gabarito={entry.data.gabarito}
  breadcrumb={[
    { label: 'Escolar', href: u('/escolar') },
    { label: subjectLabel, href: u(`/escolar/${materia}/`) },
    { label: bimLabelFn(bimestre ?? ''), href: u(`/escolar/${materia}/#${bimestre}`) },
    { label: entry.data.title },
  ]}
>
  {/* Componente que o MDX da aula usa sem import. */}
  {Content && <Content components={{ Accordion }} />}
</Tema>
