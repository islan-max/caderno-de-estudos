---
import { secaoVisivel } from '../../../lib/secoes';
import Base from '../../../layouts/Base.astro';
import { u } from '../../../lib/url';
import { materiasEscolar } from '../../../lib/escolar';

export async function getStaticPaths() {
  // Seção oculta (src/lib/secoes.ts): nenhuma rota é gerada.
  if (!secaoVisivel('escolar')) return [];
  return (await materiasEscolar()).map((m) => ({ params: { materia: m.slug } }));
}

const { materia: materiaSlug } = Astro.params;
const materia = (await materiasEscolar()).find((m) => m.slug === materiaSlug);
if (!materia) return Astro.redirect(u('/escolar'));
---

<Base
  title={materia.nome}
  active="escolar"
  description={`Bimestres de ${materia.nome}`}
  voltar={{ href: u('/escolar'), label: 'Matérias do Escolar' }}
>
  <nav class="font-mono text-xs text-ink-soft mb-4" aria-label="Você está aqui">
    <a href={u('/escolar')} class="hover:text-ink underline underline-offset-2">Escolar</a>
    <span> / </span>
    <span class="text-ink">{materia.nome}</span>
  </nav>
  <h1 class="font-display text-3xl md:text-4xl font-bold text-ink mb-8">{materia.nome}</h1>

  <ul class="flex flex-col gap-3 list-none p-0 m-0">
    {materia.bimestres.map((b) => {
      const total = b.aulas.length;
      return (
        <li>
          <a
            href={u(`/escolar/${materia.slug}/${b.slug}/`)}
            class="flex items-center justify-between gap-4 rounded-md border border-paper-dark px-5 py-4 hover:border-escolar transition-colors bg-white/50"
          >
            <span class="font-body text-ink font-medium">{b.label}</span>
            <span class="font-mono text-xs text-ink-soft shrink-0">
              {total} {total === 1 ? 'aula' : 'aulas'} →
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>
