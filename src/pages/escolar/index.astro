---
import SecaoOculta from '../../components/SecaoOculta.astro';
import { secaoVisivel } from '../../lib/secoes';
import Base from '../../layouts/Base.astro';
import TopoSecao from '../../components/TopoSecao.astro';
import AreaMaterias from '../../components/AreaMaterias.astro';
import { materiasEscolar } from '../../lib/escolar';
import { contarAulas, grupoDaSecao, idsProntos } from '../../lib/materiasSecoes';

// Seção oculta (src/lib/secoes.ts): a rota continua existindo (links antigos não
// quebram), mas some da navegação e não gera nenhuma página interna.
const oculta = !secaoVisivel('escolar');

const materias = await materiasEscolar();
const grupo = grupoDaSecao('escolar', 'Escolar', 'book-open', materias);
const porMateria = new Map(materias.map((m) => [m.slug, idsProntos(m)]));
const emBreve = new Map(
  materias.map((m) => {
    const { total, prontas } = contarAulas(m.bimestres);
    return [m.slug, total - prontas] as const;
  })
);
---

<Base title="Escolar" active="escolar" description="Aulas de Escolar, por matéria e bimestre">
  {oculta ? (
    <SecaoOculta nome="Escolar" />
  ) : (
    <Fragment>
      <TopoSecao icone="book-open" selo="Escolar" titulo="Matérias" cor="var(--color-escolar)">
        Escolha uma matéria: cada uma reúne as aulas do bimestre, na ordem em que foram dadas em sala, para quem faltou ou quer revisar. As aulas ainda não escritas aparecem como “Em breve”; as que a escola não liberou, como “Sem material”.
      </TopoSecao>
      <AreaMaterias area={grupo} porMateria={porMateria} emBreve={emBreve} base="/escolar" cabeca={false} />
    </Fragment>
  )}
</Base>
